<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WoWBoxer Window Layouts desktop app: monitor canvas, layout editor, profiles, squad flow, tray. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WoWBoxer.Layouts.App</RootNamespace>
    <AssemblyName>WoWBoxer.Layouts</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
        <!-- WFO0003: WinForms wants DPI mode in code; this is a WPF app and the manifest is the right place. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <!-- Own Main (Program.cs): Velopack's install/update hooks must run before WPF starts. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- Installer + delta updates from GitHub Releases (docs/plan.md §3). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep WPF's types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WoWBoxer.Layouts.Core\WoWBoxer.Layouts.Core.csproj" />
    <ProjectReference Include="..\WoWBoxer.Layouts.Win32\WoWBoxer.Layouts.Win32.csproj" />
  </ItemGroup>

</Project>
