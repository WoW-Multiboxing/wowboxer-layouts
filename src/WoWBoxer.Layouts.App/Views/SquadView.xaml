<UserControl x:Class="WoWBoxer.Layouts.App.Views.SquadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- ===== Start + party ===== -->
        <ContentControl Style="{StaticResource OrnatePanel}" Padding="28,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="Start your squad" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,24,0" Foreground="{StaticResource MutedBrush}"
                                   Text="Battle.net opens, you press Play once per account – in the order below – and every game window jumps into its place. Nothing is ever sent to the game." />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource StepLabel}" Text="GAME" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <RadioButton Style="{StaticResource SmallSegButton}" Content="Classic Era" GroupName="game"
                                         IsChecked="{Binding Forever, Converter={x:Static app:InvertBool.Instance}}" ToolTip="Changes only the Battle.net instructions" />
                            <RadioButton Style="{StaticResource SmallSegButton}" Content="Forever" GroupName="game" IsChecked="{Binding Forever}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Width="300">
                        <Button Style="{StaticResource EnterWorldButton}" Command="{Binding StartSquadCommand}" HorizontalAlignment="Stretch"
                                ToolTip="Starts Battle.net if needed, then places each WoW window as it opens (Ctrl+Enter)">
                            <TextBlock Text="▶  START SQUAD" />
                        </Button>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Content="Arrange now" Command="{Binding ArrangeCommand}" Margin="0,0,6,0"
                                    ToolTip="Place the WoW windows that are already open, in the order on the right (F5)" />
                            <Button Content="Stop watching" Command="{Binding StopCommand}" Margin="6,0,0,0" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11.5" HorizontalAlignment="Center"
                                   Text="Watching for new game windows …" Foreground="{StaticResource GoldHiBrush}"
                                   Visibility="{Binding IsWatching, Converter={x:Static app:BoolVisibility.Instance}}" />
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" Style="{StaticResource Divider}" Margin="0,22,0,16" />

                <DockPanel Grid.Row="2">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Bottom"
                                   Text="Names and colours come from the Setup tab." />
                        <TextBlock Style="{StaticResource StepLabel}" Text="PRESS PLAY IN THIS ORDER" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Party}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- party-frame style row -->
                                    <Border CornerRadius="6" Margin="0,0,0,8" Padding="12,10" BorderThickness="1" BorderBrush="#2E3850">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1C2333" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                                <Ellipse Fill="#0B0E14" Stroke="{Binding ClassBrush}" StrokeThickness="2.5" />
                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource ParchmentBrush}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{Binding ClassBrush}" Effect="{StaticResource HardTextShadow}" />
                                                <Rectangle Height="5" Margin="0,6,24,0" RadiusX="2" RadiusY="2" Fill="{Binding ClassBrush}" Opacity="0.55" />
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Text="{Binding Account, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     ToolTip="Optional: the Battle.net account to press Play with (only shown here, never used to log in)" />
                                            <TextBlock Grid.Column="2" Text="Battle.net account (optional)" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                                                       Foreground="#66A79F8A" FontSize="12.5"
                                                       Visibility="{Binding Account, Converter={x:Static app:BoolVisibility.Instance}, ConverterParameter=not}" />
                                            <Border Grid.Column="3" CornerRadius="10" BorderThickness="1" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    BorderBrush="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" Background="#40000000">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </ContentControl>

        <!-- ===== Windows + activity ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Style="{StaticResource OrnatePanel}" Padding="18,16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshWindowsCommand}" Padding="10,4" ToolTip="Look for WoW windows again" />
                        <Button DockPanel.Dock="Right" Content="Identify" Command="{Binding IdentifyCommand}" Padding="10,4" Margin="0,0,6,0"
                                ToolTip="Show each window's slot number on top of it for a few seconds (Ctrl+I)" />
                        <TextBlock Style="{StaticResource StepLabel}" Text="OPEN WOW WINDOWS" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding SquadHint}" />
                    <ItemsControl ItemsSource="{Binding Windows}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Background="#14E9DFC4" BorderBrush="#2E3850" BorderThickness="1" Padding="10,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="▲" Padding="8,2" Margin="0,0,4,0" ToolTip="Earlier slot"
                                                    Command="{Binding DataContext.MoveWindowUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="▼" Padding="8,2" ToolTip="Later slot"
                                                    Command="{Binding DataContext.MoveWindowDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Slot}" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource GoldHiBrush}" Width="28" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Process}" Foreground="{StaticResource ParchmentBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Row="2" Style="{StaticResource OrnatePanel}" Padding="18,16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open logs" Command="{Binding OpenLogsCommand}" />
                        <TextBlock Style="{StaticResource StepLabel}" Text="ACTIVITY" />
                    </DockPanel>
                    <Border CornerRadius="5" BorderBrush="#8E8E8E" BorderThickness="1" Padding="8,6">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0C0F1E" Offset="0" /><GradientStop Color="#060812" Offset="1" /></LinearGradientBrush></Border.Background>
                        <ListBox x:Name="StatusList" ItemsSource="{Binding Status.Lines}" FontFamily="{StaticResource MonoFont}" FontSize="11.5">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,1" /></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Foreground="{Binding Brush}">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#6B6F7A" /> <Run Text="{Binding Message, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
