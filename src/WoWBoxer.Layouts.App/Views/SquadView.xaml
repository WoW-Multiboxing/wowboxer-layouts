<UserControl x:Class="WoWBoxer.Layouts.App.Views.SquadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWBoxer.Layouts.App.Controls"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App">
    <!-- App mockup v0.2, 2-Squad: rows per window on the left, "Start your squad" checklist on the right -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ===== Your squad ===== -->
        <ContentControl Style="{StaticResource OrnatePanel}" Padding="26,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource H1}" Text="Your squad" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Margin="0,6,0,0">
                        <Run Text="Row 1 gets the first window that opens, row 2 the next … Drag ⋮⋮ to reorder · layout" /> <Run Text="{Binding LayoutTitle, Mode=OneWay}" Foreground="{StaticResource GoldHiBrush}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <ContentControl Style="{StaticResource Divider}" Margin="0,0,0,14" />
                    <WrapPanel>
                        <Button Content="Arrange now" Command="{Binding ArrangeCommand}" Margin="0,0,8,8" ToolTip="Place the open WoW windows in the order above (F5)" />
                        <Button Content="Identify all" Command="{Binding IdentifyCommand}" Margin="0,0,8,8" ToolTip="Show each window's number on top of it for a few seconds (Ctrl+I)" />
                        <Button Content="Give title bars back" Command="{Binding RestoreFramesCommand}" Margin="0,0,8,8" />
                        <Button Content="Diagnose…" Command="{Binding DiagnoseCommand}" Margin="0,0,8,8"
                                ToolTip="Write a report (monitors, windows, admin rights, WoW display settings) you can send when you ask for help" />
                    </WrapPanel>
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="470">
                        <ItemsControl x:Name="PartyList" ItemsSource="{Binding Party}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="6" Margin="0,0,0,8" Padding="8,10,12,10" BorderThickness="1" BorderBrush="#2E3850"
                                            AllowDrop="True" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop" Tag="{Binding}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1C2333" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- drag handle -->
                                            <Border Background="Transparent" Cursor="SizeAll" Tag="{Binding}" ToolTip="Drag to move this character (and its window) to another slot"
                                                    PreviewMouseLeftButtonDown="OnHandleDown" PreviewMouseMove="OnHandleMove">
                                                <TextBlock Text="⋮⋮" FontSize="18" Foreground="{StaticResource GoldLoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid Grid.Column="1" Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="2.5">
                                                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#232B3E" Offset="0" /><GradientStop Color="#0B0E14" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource UiGoldBrush}" Effect="{StaticResource HardTextShadow}" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                                    <Grid>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource DisplayFont}" Foreground="{Binding ClassBrush}"
                                                                 ToolTip="The character playing in this slot. Press Enter to save." />
                                                        <TextBlock Text="{Binding Title}" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#80A79F8A"
                                                                   FontFamily="{StaticResource DisplayFont}"
                                                                   Visibility="{Binding Name, Converter={x:Static app:BoolVisibility.Instance}, ConverterParameter=not}" />
                                                    </Grid>
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Classes}" SelectedItem="{Binding Class}" ToolTip="The class of this character – set it once; the app never guesses">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                <TextBlock Margin="2,6,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" /> <Run Text="·" /> <Run Text="{Binding Window, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}"
                                                          ToolTip="The WoW account this slot logs in with (from your WTF folder). Stays on this PC.">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={x:Static app:EmptyAs.Instance}, ConverterParameter=WoW account: not set}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <DockPanel Margin="2,6,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Use" Command="{Binding UseHint}" FontSize="11.5"
                                                            ToolTip="Use this character's name for the slot" />
                                                    <TextBlock Text="{Binding HintText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="A hint from the WTF folder (the character folder WoW wrote last) – not a fact" />
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                                                <Border CornerRadius="10" BorderThickness="1" Padding="10,3" Width="86" Margin="0,0,8,0"
                                                        BorderBrush="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" Background="#40000000">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Identify" Command="{Binding Identify}" Padding="10,4" FontSize="11.5" ToolTip="Show this slot's number on its WoW window" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                            <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- the layout these rows go into -->
                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SquadHint}" Style="{StaticResource Muted}" Margin="2,0,0,8" />
                        <Border CornerRadius="6" Background="#05070B" BorderBrush="#3A4560" BorderThickness="1" MinHeight="110">
                            <c:LayoutCanvas Compact="True" Profile="{Binding Current}" Monitors="{Binding Monitors}" IsHitTestVisible="False" Margin="10" />
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </ContentControl>

        <!-- ===== Start your squad ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="19" Text="Start your squad" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton Style="{StaticResource SmallSegButton}" Content="Classic Era" GroupName="game"
                                     IsChecked="{Binding Forever, Converter={x:Static app:InvertBool.Instance}}" ToolTip="Changes only the Battle.net instructions" />
                        <RadioButton Style="{StaticResource SmallSegButton}" Content="Forever" GroupName="game" IsChecked="{Binding Forever}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StepLabel}" Text="HOW TO START" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SmallSegButton}" Content="Battle.net" GroupName="launch" IsChecked="{Binding LaunchViaBattleNet}"
                                     ToolTip="Opens Battle.net; you press Play once per account (choose the account in Battle.net each time)" />
                        <RadioButton Style="{StaticResource SmallSegButton}" Content="Login screens" GroupName="launch" IsChecked="{Binding LaunchLoginScreens}"
                                     ToolTip="Opens one WoW login screen per missing client; you log in to each yourself. Nothing is typed for you." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Checklist}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse x:Name="Ring" Stroke="{StaticResource GoldLoBrush}" StrokeThickness="1.5" />
                                        <Path x:Name="Tick" Data="M5,10 L8.5,13.5 L15,6.5" Stroke="{StaticResource OkBrush}" StrokeThickness="2.2" Opacity="0" />
                                    </Grid>
                                    <TextBlock x:Name="Label" Text="{Binding Label}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource OkBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- WoW tooltip style note -->
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="#8E8E8E" Padding="12,9" Margin="0,8,0,16">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0C0F1E" Offset="0" /><GradientStop Color="#060812" Offset="1" /></LinearGradientBrush></Border.Background>
                        <StackPanel>
                            <TextBlock Text="You press Play" Foreground="{StaticResource UiGoldBrush}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock TextWrapping="Wrap" Foreground="#E4E4E4" FontSize="12.5" Margin="0,3,0,0"
                                       Text="WoWBoxer never logs in for you and never sends keys to the game. It only places windows." />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource EnterWorldButton}" Command="{Binding StartSquadCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Starts Battle.net if needed, then places each WoW window as it opens (Ctrl+Enter)">
                        <TextBlock Text="▶  START SQUAD" />
                    </Button>
                    <Button Content="Stop watching" Command="{Binding StopCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                            Visibility="{Binding IsWatching, Converter={x:Static app:BoolVisibility.Instance}}" />
                    <Button Content="Close clients I started" Command="{Binding CloseMineCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            ToolTip="Closes only the login screens this app opened – never your own clients" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Row="2" Style="{StaticResource OrnatePanel}" Padding="18,16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open logs" Command="{Binding OpenLogsCommand}" />
                        <TextBlock Style="{StaticResource StepLabel}" Text="ACTIVITY" />
                    </DockPanel>
                    <Border CornerRadius="5" BorderBrush="#8E8E8E" BorderThickness="1" Padding="8,6">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0C0F1E" Offset="0" /><GradientStop Color="#060812" Offset="1" /></LinearGradientBrush></Border.Background>
                        <ListBox x:Name="StatusList" ItemsSource="{Binding Status.Lines}" FontFamily="{StaticResource MonoFont}" FontSize="11.5">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,1" /></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Foreground="{Binding Brush}">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#6B6F7A" /> <Run Text="{Binding Message, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
