<UserControl x:Class="WoWBoxer.Layouts.App.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App"
             xmlns:vm="clr-namespace:WoWBoxer.Layouts.App.ViewModels">
    <!-- Quest log: chapter list on the left, a parchment page on the right (app mockup v0.2, 3-Guide) -->
    <Grid DataContext="{Binding Guide}" MaxWidth="1240">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="10,0,0,10" BorderThickness="1,1,0,1" BorderBrush="#73C9A24A" Padding="12,18">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1C2333" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush></Border.Background>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="QUICK GUIDE" Style="{StaticResource H2}" Foreground="{StaticResource GoldHiBrush}" Margin="8,0,0,12" />
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource EnterWorldButton}" FontSize="13.5" Padding="12,10" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{x:Static vm:MainViewModel.WebsiteGuideUrl}" ToolTip="Opens the full guide in your browser">
                        <TextBlock Text="FULL GUIDE ON THE WEBSITE  ↗" />
                    </Button>
                    <TextBlock Text="Pictures, videos and the rules – on the WoWBoxer website" Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Chapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,4" AutomationProperties.Name="{Binding Title}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="6" Padding="10,10" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Mark" Text="{Binding Mark}" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="{StaticResource GoldLoBrush}" Width="20" />
                                                <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Width="230" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#1AC9A24A" />
                                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource UiGoldBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#29C9A24A" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource UiGoldBrush}" />
                                                <Setter TargetName="Bg" Property="BorderThickness" Value="2,0,0,0" />
                                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource UiGoldBrush}" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource UiGoldBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- the parchment page -->
        <Border Grid.Column="1" CornerRadius="0,10,10,0" BorderThickness="1" BorderBrush="#8C6B26" ClipToBounds="True">
            <Border.Background>
                <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.3,0.2" RadiusX="0.9" RadiusY="1.1">
                    <GradientStop Color="#F3EAD2" Offset="0" /><GradientStop Color="#E9DFC4" Offset="0.55" /><GradientStop Color="#D9C9A0" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            <Grid>
                <!-- burnt edge: a soft brown vignette -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush RadiusX="0.72" RadiusY="0.78" Center="0.5,0.45" GradientOrigin="0.5,0.45">
                            <GradientStop Color="#00785014" Offset="0.62" /><GradientStop Color="#55785014" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Page" Margin="48,40,48,40" MaxWidth="780" HorizontalAlignment="Left" DataContext="{Binding Current}">
                        <TextBlock Text="{Binding DataContext.ChapterText, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" FontSize="12" Foreground="#7A5A22" />
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="32" Foreground="#3A2410" Margin="0,6,0,16" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Intro}" FontSize="16" LineHeight="26" Foreground="#3B2A14" TextWrapping="Wrap" Margin="0,0,0,20" />
                        <TextBlock Text="Objectives" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="#5A3A12" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Objectives}" Margin="0,0,0,22">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10">
                                        <Rectangle Width="8" Height="8" Fill="#8C6B26" VerticalAlignment="Top" Margin="2,8,12,0" RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock Text="{Binding}" FontSize="15" LineHeight="24" Foreground="#2B1E0E" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border CornerRadius="6" Background="#1A5A3A12" BorderBrush="#595A3A12" BorderThickness="1" Padding="16,14">
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#3B2A14">
                                <Run Text="Good to know – " FontFamily="{StaticResource DisplayFont}" Foreground="#5A3A12" /><Run Text="{Binding Note, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Button Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding ActionCommand}" Cursor="Hand"
                                Visibility="{Binding HasAction, Converter={x:Static app:BoolVisibility.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" CornerRadius="6" BorderThickness="1" BorderBrush="#5A3A12" Padding="20,12">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#6E4A1A" Offset="0" /><GradientStop Color="#4A2E0E" Offset="1" /></LinearGradientBrush></Border.Background>
                                        <TextBlock Text="{Binding Action}" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="#F3EAD2" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
