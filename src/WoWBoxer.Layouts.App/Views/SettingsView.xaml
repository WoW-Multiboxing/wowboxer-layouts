<UserControl x:Class="WoWBoxer.Layouts.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App">
    <UserControl.Resources>
        <Style x:Key="Setting" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Explain" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,3,60,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1100" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Window rules" />
                        <TextBlock Style="{StaticResource Explain}" Text="{Binding LayoutTitle, StringFormat=For the layout {0}.}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,12,0,4" Text="Narrowest window shape" />
                        <ComboBox ItemsSource="{Binding AspectChoices}" SelectedItem="{Binding SelectedAspect}" HorizontalAlignment="Left" MinWidth="300"
                                  AutomationProperties.Name="Narrowest window shape"
                                  ToolTip="Windows narrower than this are shortened (never stretched). With Auto-fit action bar on, 5:4 is fine." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding CoverTaskbar}"><TextBlock Text="Cover the taskbar area" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="{Binding TaskbarHint}" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Borderless}"><TextBlock Text="Remove title bars" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Off is safest: in our tests WoW sometimes drew its UI at the wrong size after the frame was removed." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Action bar (UI Scale)" />
                        <TextBlock Style="{StaticResource Explain}" Text="{Binding UiScaleText}" AutomationProperties.AutomationId="UiScaleText" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding AutoFitActionBar}" AutomationProperties.Name="Auto-fit action bar"><TextBlock Text="Auto-fit action bar" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="When all clients of the install are closed (at start, before opening clients, or when the last one closes), the app sets WoW's UI Scale so the whole action bar fits in every window. Only then: WoW shares one UI Scale per install and saves it when a client closes. A backup is kept." />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Fix action bar now" Command="{Binding FixUiScaleCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="FixUiScale"
                                    ToolTip="Sets the UI Scale now (all clients closed), or tells you what to set in game" />
                            <Button Content="UI Scale off" Command="{Binding ResetUiScaleCommand}" Margin="0,0,8,8"
                                    ToolTip="Turns Use UI Scale off again (and Auto-fit). Only while all clients are closed." />
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Windows" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding RenameWindows}"><TextBlock Text="Title WoW windows with the character names" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="The game windows become &quot;WoW - name&quot; on the taskbar, for windows with a character name." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Animations}"><TextBlock Text="Animations" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Windows glide into place on the map, and waiting slots pulse. Turn off for a calmer screen." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding StartPlacingOnOpen}" AutomationProperties.AutomationId="StartPlacingOnOpen"><TextBlock Text="Start placing windows when the app opens" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Off (default): the app opens stopped and leaves every window alone – safe when you play another game or WoW version – until you press Start placing windows. Desktop layout shortcuts always start." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="WoW client" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding GameExe, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="WoW client"
                                     ToolTip="Found automatically: the open clients' install, else the last one used" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Every WoW install works (Classic Era, Forever, Retail …). The squad follows the install with the most open windows; this is the one &quot;Open WoW clients&quot;, UI Scale and the account hints use when none is open. The WTF folder is only read, except the UI Scale." />
                        <Button Content="Read accounts and characters again" Command="{Binding RefreshHintsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Battle.net" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBattleNetCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding BattleNetExe, UpdateSourceTrigger=LostFocus}" ToolTip="Found automatically; change it only if Battle.net lives somewhere unusual" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="&quot;Open Battle.net instead&quot; starts it if it is not running. Start it normally – not as administrator." />
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Tools" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Identify all windows" Command="{Binding IdentifyCommand}" Margin="0,0,8,8" ToolTip="Show each window's number on top of it for a few seconds (Ctrl+I)" />
                            <Button Content="Close clients I started" Command="{Binding CloseMineCommand}" Margin="0,0,8,8"
                                    ToolTip="Closes only the login screens this app opened – never your own clients" />
                            <Button Content="Give title bars back" Command="{Binding RestoreFramesCommand}" Margin="0,0,8,8"
                                    ToolTip="Undo &quot;Remove title bars&quot; on every open WoW window" />
                            <Button Content="Open layouts folder" Command="{Binding OpenLayoutsFolderCommand}" Margin="0,0,8,8" />
                            <Button Content="Show welcome screen" Command="{Binding ShowFirstRunCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Something wrong? The Help tab has Report a problem, Diagnose, the logs and the common problems." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel DataContext="{Binding Hover}">
                        <TextBlock Style="{StaticResource H2}" Text="Switching windows" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Enabled}" AutomationProperties.AutomationId="HoverToggleSettings" AutomationProperties.Name="Hover to activate windows"><TextBlock Text="Hover to activate windows" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Turns on Windows' own &quot;Activate a window by hovering over it with the mouse&quot; (Ease of Access). The window under the mouse becomes active, so your next key press goes there. A Windows setting for your user – WoWBoxer still never sends anything to the game." />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,12,0,0" Text="Delay" />
                        <DockPanel Margin="0,2,60,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DelayText}" Width="120" Margin="10,0,0,0" Foreground="{StaticResource ParchmentBrush}" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="500" Ticks="30" SmallChange="5" LargeChange="50" Value="{Binding DelayPreview}"
                                    app:SliderCommit.Command="{Binding CommitDelayCommand}" AutomationProperties.AutomationId="HoverDelaySettings" AutomationProperties.Name="Hover delay in milliseconds" />
                        </DockPanel>
                        <DockPanel Margin="0,2,60,0">
                            <Button DockPanel.Dock="Right" Content="Reset to default" Command="{Binding ResetDelayCommand}" AutomationProperties.AutomationId="HoverResetDelaySettings"
                                    ToolTip="Sets the delay back to 30 ms, at once" />
                            <TextBlock Text="{Binding DefaultDelayText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="0–500 ms. Turning hover on sets 30 ms, the default (the mark): it stops windows from activating while the mouse just passes over them. Move the slider for faster or slower; it applies when you let go. Reset to default puts 30 ms back." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding BringToFront}"><TextBlock Text="Bring window to front when activated" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Off keeps floating overlays visible: the active window stays where it is in the stack. Works best with &quot;Always on top&quot; (the pin in Your squad) on the floating followers." />
                        <Border Style="{StaticResource TipBox}" Margin="0,14,60,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#E4E4E4">
                                <Run Text="Hover to activate is a Windows setting. It sends nothing to the game; WoWBoxer never sends keys or clicks." />
                                <LineBreak />
                                <Hyperlink Command="{Binding OpenGuideCommand}" Foreground="{StaticResource GoldHiBrush}">Guide</Hyperlink>
                                <Run Text=" · " Foreground="{StaticResource MutedBrush}" />
                                <Hyperlink Command="{Binding OpenRulesCommand}" Foreground="{StaticResource GoldHiBrush}">Rules on the website</Hyperlink>
                            </TextBlock>
                        </Border>
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding TurnOffOnExit}" AutomationProperties.AutomationId="HoverOffOnExit"><TextBlock Text="Turn hover to activate off when WoWBoxer quits" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="On by default: closing the app (the window's ✕, Quit in the tray, or signing out of Windows) turns it off again. The delay stays for next time." />
                        <TextBlock Style="{StaticResource Explain}" Margin="0,14,60,0" Text="{Binding OriginalText}" AutomationProperties.AutomationId="HoverOriginal" />
                        <Button Content="Restore my original Windows settings" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.AutomationId="HoverRestore"
                                ToolTip="Puts hover to activate, its delay and &quot;bring to front&quot; back the way they were before WoWBoxer first changed them" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding RestoreOnExit}" AutomationProperties.AutomationId="HoverRestoreOnExit"><TextBlock Text="Restore them when WoWBoxer quits (instead of just turning it off)" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Uninstalling WoWBoxer always restores them." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Shortcuts" />
                        <Button Content="Create a desktop shortcut for this layout" Click="OnCreateShortcut" HorizontalAlignment="Left" Margin="0,12,0,0"
                                ToolTip="One click: opens the app in the tray with this layout and opens the missing clients" />
                        <TextBlock Style="{StaticResource Explain}" Text="The shortcut starts the app in the tray with the layout you have open now and opens the missing WoW clients' login screens." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Updates and privacy" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding CheckForUpdates}"><TextBlock Text="Check for updates when the app starts" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Asks GitHub for a new version (you choose Update now or Later) and, at most once a day, reads the community links from wowboxer.com. Both are plain web requests that send nothing about you. Off = no network at all. No telemetry, ever." />
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
