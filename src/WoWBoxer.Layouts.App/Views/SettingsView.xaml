<UserControl x:Class="WoWBoxer.Layouts.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App"
             xmlns:vm="clr-namespace:WoWBoxer.Layouts.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Setting" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Explain" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,3,60,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1100" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Window rules" />
                        <TextBlock Style="{StaticResource Explain}" Text="{Binding LayoutTitle, StringFormat=For the layout {0}.}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,12,0,4" Text="Narrowest window shape" />
                        <ComboBox ItemsSource="{Binding AspectChoices}" SelectedItem="{Binding SelectedAspect}" HorizontalAlignment="Left" MinWidth="300"
                                  AutomationProperties.Name="Narrowest window shape"
                                  ToolTip="Windows narrower than this are shortened (never stretched). With Auto-fit action bar on, 5:4 is fine." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding CoverTaskbar}"><TextBlock Text="Cover the taskbar area" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="{Binding TaskbarHint}" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Borderless}"><TextBlock Text="Remove title bars" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Off by default. On removes the Windows frame with popup chrome so the slot size is the game area; keep WoW on Windowed." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Action bar (UI Scale)" />
                        <TextBlock Style="{StaticResource Explain}" Text="{Binding UiScaleText}" AutomationProperties.AutomationId="UiScaleText" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding AutoFitActionBar}" AutomationProperties.Name="Auto-fit action bar"><TextBlock Text="Auto-fit action bar" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="When all clients of the install are closed (at start, before opening clients, or when the last one closes), the app sets WoW's UI Scale so every action bar you have on (bars 1–3, the right bars, bags) fits in every window – Classic Era and Forever. Only then: WoW shares one UI Scale per install and saves it when a client closes. A backup is kept. It never goes below 0.75 by itself. Clients where the WoWBoxer AddOn fits the bars in each window (AddOn 1.3.0 or newer) keep their UI Scale: WoWBoxer never lowers it for them, and puts your own one back when the AddOn handles every window." />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Fix action bar now" Command="{Binding FixUiScaleCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="FixUiScale"
                                    ToolTip="Sets the UI Scale now (all clients closed), or tells you what to set in game" />
                            <Button Content="UI Scale off" Command="{Binding ResetUiScaleCommand}" Margin="0,0,8,8"
                                    ToolTip="Turns Use UI Scale off again (and Auto-fit). Only while all clients are closed." />
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Windows" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding RenameWindows}"><TextBlock Text="Title WoW windows with the character names" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="The game windows become &quot;WoW - name&quot; on the taskbar, for windows with a character name." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Animations}"><TextBlock Text="Animations" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Windows glide into place on the map, and waiting slots pulse. Turn off for a calmer screen." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding StartPlacingOnOpen}" AutomationProperties.AutomationId="StartPlacingOnOpen"><TextBlock Text="Start placing windows when the app opens" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Off (default): the app opens stopped and leaves every window alone – safe when you play another game or WoW version – until you press Start placing windows. Desktop layout shortcuts always start." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="WoW client" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding GameExe, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="WoW client"
                                     ToolTip="Found automatically: the open clients' install, else the last one used" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Every WoW install works (Classic Era, Forever, Retail …). The squad follows the install with the most open windows; this is the one &quot;Open WoW clients&quot;, UI Scale and the account hints use when none is open. The WTF folder is only read, except the UI Scale." />
                        <Button Content="Read accounts and characters again" Command="{Binding RefreshHintsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Battle.net" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBattleNetCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding BattleNetExe, UpdateSourceTrigger=LostFocus}" ToolTip="Found automatically; change it only if Battle.net lives somewhere unusual" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="&quot;Open Battle.net instead&quot; starts it if it is not running. Start it normally – not as administrator." />
                    </StackPanel>
                </ContentControl>

                <!-- Window swap (advanced, off by default). Only moves windows; the hotkeys go to WoWBoxer, never to the game. -->
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0" AutomationProperties.AutomationId="AdvancedPanel">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Advanced" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding SwapHotkeysEnabled}" AutomationProperties.AutomationId="SwapHotkeys" AutomationProperties.Name="Window swap hotkeys">
                            <TextBlock Text="Window swap hotkeys" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Hotkeys that move a client's window into the main slot; the client that was there takes its old place. Off by default." />
                        <Border Style="{StaticResource TipBox}" Margin="0,12,60,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#E4E4E4">
                                <Run Text="{Binding SwapNote, Mode=OneWay}" />
                                <LineBreak />
                                <Hyperlink Command="{Binding OpenSwapGuideCommand}" Foreground="{StaticResource GoldHiBrush}">Guide: Swap windows (advanced)</Hyperlink>
                            </TextBlock>
                        </Border>

                        <StackPanel Visibility="{Binding SwapHotkeysEnabled, Converter={x:Static app:BoolVisibility.Instance}}">
                            <TextBlock Text="{Binding SwapStatusText}" Foreground="{StaticResource OkBrush}" FontSize="12" Margin="0,12,0,0" AutomationProperties.AutomationId="SwapStatus" />
                            <TextBlock Style="{StaticResource Explain}" Text="Click a box and press the keys (Esc cancels). Two or more of Ctrl, Alt and Shift keep them away from your game keys. The key press goes to WoWBoxer, not to the game." />
                            <ItemsControl ItemsSource="{Binding HotkeyRows}" Margin="0,8,0,0" AutomationProperties.AutomationId="HotkeyRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,4">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}" Width="170" VerticalAlignment="Center" FontSize="12.5" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding ClearCommand}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="No hotkey for this action" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Default" Command="{Binding DefaultCommand}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="The recommended hotkey" />
                                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" FontSize="12" Padding="6,2"
                                                         AutomationProperties.Name="{Binding Title}" ToolTip="Click, then press the keys"
                                                         GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur" PreviewKeyDown="OnHotkeyBoxKey" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Notes}" Foreground="{StaticResource WarnBrush}" FontSize="11" TextWrapping="Wrap" Margin="170,1,0,0"
                                                       Visibility="{Binding HasNotes, Converter={x:Static app:BoolVisibility.Instance}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource LinkButton}" Content="All back to the recommended hotkeys" Command="{Binding ResetAllHotkeysCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="11.5" />
                            <!-- edits only take effect with Apply (the owner's wish, 2026-11-02) -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasPendingHotkeys, Converter={x:Static app:BoolVisibility.Instance}}">
                                <Button Content="Apply hotkeys" Command="{Binding ApplyHotkeyChangesCommand}" Padding="14,4" AutomationProperties.AutomationId="ApplyHotkeys"
                                        ToolTip="Start using the hotkeys above (until then the old ones keep working)" />
                                <Button Content="Discard" Command="{Binding DiscardHotkeyChangesCommand}" Padding="12,4" Margin="8,0,0,0" AutomationProperties.AutomationId="DiscardHotkeys"
                                        ToolTip="Forget the changes and keep the hotkeys in use" />
                                <TextBlock Text="Changes are not in use until you apply them." Foreground="{StaticResource WarnBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,16,0,4" Text="Next / previous go through" />
                            <ComboBox ItemsSource="{Binding SwapScopeChoices}" SelectedItem="{Binding SwapScope}" HorizontalAlignment="Left" MinWidth="300" AutomationProperties.Name="Next and previous go through" />
                            <TextBlock Style="{StaticResource Explain}" Text="With 6–10 clients each party has its own main slot. &quot;The party of the active window&quot; cycles the party whose window has your keys." />

                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,14,0,4" Text="Order" />
                            <ItemsControl ItemsSource="{Binding SwapOrderPresets}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Command="{Binding DataContext.UseSwapOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Margin="0,0,8,8" Padding="10,3" FontSize="11.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SwapOrderText}" FontSize="12" Foreground="{StaticResource ParchmentBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="SwapOrder" />
                            <TextBlock Style="{StaticResource Explain}" Text="Your own order: click the clients below in the order you want (a client can come back, e.g. 1, 3, 1, 4). Drag a chip in your order to move it; click it to remove it." />
                            <ItemsControl ItemsSource="{Binding SwapOrderChips}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#33E8C66A" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,6" Cursor="Hand"
                                                Tag="{Binding}" ToolTip="Drag to move · click to remove" AllowDrop="True"
                                                PreviewMouseLeftButtonDown="OnChipDown" PreviewMouseMove="OnChipMove" PreviewMouseLeftButtonUp="OnChipUp" Drop="OnChipDrop">
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource GoldHiBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding SwapOrderSource}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding DataContext.AddToSwapOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Margin="0,0,6,6" Padding="8,2" FontSize="11" ToolTip="Add to your order" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource LinkButton}" Content="Clear my order (number order)" Command="{Binding ClearSwapOrderCommand}" HorizontalAlignment="Left" FontSize="11.5" />

                            <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding SwapRemember}" AutomationProperties.AutomationId="SwapRemember"><TextBlock Text="Remember swapped positions after a restart" /></CheckBox>
                            <TextBlock Style="{StaticResource Explain}" Text="Off: WoWBoxer always starts in the home layout." />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Tools" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Identify all windows" Command="{Binding IdentifyCommand}" Margin="0,0,8,8" ToolTip="Show each window's number on top of it for a few seconds (Ctrl+I)" />
                            <Button Content="Close clients I started" Command="{Binding CloseMineCommand}" Margin="0,0,8,8"
                                    ToolTip="Closes only the login screens this app opened – never your own clients" />
                            <Button Content="Give title bars back" Command="{Binding RestoreFramesCommand}" Margin="0,0,8,8"
                                    ToolTip="Undo &quot;Remove title bars&quot; on every open WoW window" />
                            <Button Content="Open layouts folder" Command="{Binding OpenLayoutsFolderCommand}" Margin="0,0,8,8" />
                            <Button Content="Show welcome screen" Command="{Binding ShowFirstRunCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Something wrong? The Help tab has Report a problem, Diagnose, the logs and the common problems." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel DataContext="{Binding Hover}">
                        <TextBlock Style="{StaticResource H2}" Text="Switching windows" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Enabled}" AutomationProperties.AutomationId="HoverToggleSettings" AutomationProperties.Name="Hover to activate windows"><TextBlock Text="Hover to activate windows" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Turns on Windows' own &quot;Activate a window by hovering over it with the mouse&quot; (Ease of Access). The window under the mouse becomes active, so your next key press goes there. A Windows setting for your user – WoWBoxer still never sends anything to the game." />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,12,0,0" Text="Delay" />
                        <DockPanel Margin="0,2,60,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DelayText}" Width="120" Margin="10,0,0,0" Foreground="{StaticResource ParchmentBrush}" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="500" Ticks="30" SmallChange="5" LargeChange="50" Value="{Binding DelayPreview}"
                                    app:SliderCommit.Command="{Binding CommitDelayCommand}" AutomationProperties.AutomationId="HoverDelaySettings" AutomationProperties.Name="Hover delay in milliseconds" />
                        </DockPanel>
                        <DockPanel Margin="0,2,60,0">
                            <Button DockPanel.Dock="Right" Content="Reset to default" Command="{Binding ResetDelayCommand}" AutomationProperties.AutomationId="HoverResetDelaySettings"
                                    ToolTip="Sets the delay back to 30 ms, at once" />
                            <TextBlock Text="{Binding DefaultDelayText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="0–500 ms. Turning hover on sets 30 ms, the default (the mark): it stops windows from activating while the mouse just passes over them. Move the slider for faster or slower; it applies when you let go. Reset to default puts 30 ms back." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding BringToFront}"><TextBlock Text="Bring window to front when activated" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Off keeps floating overlays visible: the active window stays where it is in the stack. Works best with &quot;Always on top&quot; (the pin in Your squad) on the floating followers." />
                        <Border Style="{StaticResource TipBox}" Margin="0,14,60,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#E4E4E4">
                                <Run Text="Hover to activate is a Windows setting. It sends nothing to the game; WoWBoxer never sends keys or clicks." />
                                <LineBreak />
                                <Hyperlink Command="{Binding OpenGuideCommand}" Foreground="{StaticResource GoldHiBrush}">Guide</Hyperlink>
                                <Run Text=" · " Foreground="{StaticResource MutedBrush}" />
                                <Hyperlink Command="{Binding OpenRulesCommand}" Foreground="{StaticResource GoldHiBrush}">Rules on the website</Hyperlink>
                            </TextBlock>
                        </Border>
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding TurnOffOnExit}" AutomationProperties.AutomationId="HoverOffOnExit"><TextBlock Text="Turn hover to activate off when WoWBoxer quits" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="On by default: closing the app (the window's ✕, Quit in the tray, or signing out of Windows) turns it off again. The delay stays for next time." />
                        <TextBlock Style="{StaticResource Explain}" Margin="0,14,60,0" Text="{Binding OriginalText}" AutomationProperties.AutomationId="HoverOriginal" />
                        <Button Content="Restore my original Windows settings" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.AutomationId="HoverRestore"
                                ToolTip="Puts hover to activate, its delay and &quot;bring to front&quot; back the way they were before WoWBoxer first changed them" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding RestoreOnExit}" AutomationProperties.AutomationId="HoverRestoreOnExit"><TextBlock Text="Restore them when WoWBoxer quits (instead of just turning it off)" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Uninstalling WoWBoxer always restores them." />
                    </StackPanel>
                </ContentControl>

                <!-- Sound follows the main window (owner, 2026-11-10): Windows' volume mixer only, nothing sent to the game. Off by default. -->
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0" AutomationProperties.AutomationId="SoundPanel">
                    <StackPanel DataContext="{Binding Sound}">
                        <TextBlock Style="{StaticResource H2}" Text="Sound" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Enabled}" AutomationProperties.AutomationId="SoundFollowsSettings" AutomationProperties.Name="Sound follows the main window">
                            <TextBlock Text="Sound follows the main window" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Only the client in the main slot plays; the other WoW clients are muted. It follows every swap, Re-arrange and new window at once. Off by default." />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource OkBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,60,0" AutomationProperties.AutomationId="SoundStatus"
                                   Visibility="{Binding Enabled, Converter={x:Static app:BoolVisibility.Instance}}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,12,0,0" Text="Other clients at" />
                        <DockPanel Margin="0,2,60,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FollowerText}" Width="70" Margin="10,0,0,0" Foreground="{StaticResource ParchmentBrush}" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding FollowerPercent}"
                                    app:SliderCommit.Command="{Binding CommitPercentCommand}" AutomationProperties.AutomationId="SoundFollowerPercent" AutomationProperties.Name="Other clients' volume in percent" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="0 % mutes them (the default). Above 0 they play quietly: that share of their own level in Windows' volume mixer." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding FollowActive}" AutomationProperties.AutomationId="SoundFollowActive"><TextBlock Text="Follow the active window instead" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="The window that has your keys plays (with hover to activate: the one under the mouse). While another program has the keys, the last WoW window keeps playing. Layouts without a main window (Grid) always work this way." />
                        <Border Style="{StaticResource TipBox}" Margin="0,12,60,0" Visibility="{Binding HasHint, Converter={x:Static app:BoolVisibility.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource WarnBrush}" AutomationProperties.AutomationId="SoundHint" />
                                <Button Content="Turn on Sound in Background" Command="{Binding FixBackgroundCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.AutomationId="SoundFixBackground"
                                        ToolTip="{Binding FixBackgroundTip}" ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TipBox}" Margin="0,12,60,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#E4E4E4">
                                <Run Text="{x:Static vm:SoundViewModel.Note}" />
                                <Run Text="Turning it off, closing WoWBoxer and uninstalling put every client back to its own level." />
                                <LineBreak />
                                <Hyperlink Command="{Binding OpenGuideCommand}" Foreground="{StaticResource GoldHiBrush}">Guide: Sound follows the main window</Hyperlink>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Shortcuts" />
                        <Button Content="Create a desktop shortcut for this layout" Click="OnCreateShortcut" HorizontalAlignment="Left" Margin="0,12,0,0"
                                ToolTip="One click: opens the app in the tray with this layout and opens the missing clients" />
                        <TextBlock Style="{StaticResource Explain}" Text="The shortcut starts the app in the tray with the layout you have open now and opens the missing WoW clients' login screens." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Updates and privacy" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding CheckForUpdates}"><TextBlock Text="Check for updates when the app starts" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Asks GitHub for a new version (you choose Update now or Later) and, at most once a day, reads the community links from wowboxer.com. Both are plain web requests that send nothing about you. Off = no network at all. No telemetry, ever." />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,14,0,4" Text="Update channel" />
                        <ComboBox ItemsSource="{Binding UpdateChannelChoices}" SelectedItem="{Binding UpdateChannel}" HorizontalAlignment="Left" MinWidth="160"
                                  AutomationProperties.AutomationId="UpdateChannel" AutomationProperties.Name="Update channel"
                                  ToolTip="Stable: normal releases only. Beta: also test versions, a few days before everyone else." />
                        <TextBlock Style="{StaticResource Explain}" Text="Stable (the default) gets normal releases only. Beta also gets test versions a few days before everyone else – they may still have bugs. A change counts from the next update check (the next start). Back to Stable keeps the version you have until a newer stable one is out." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0" AutomationProperties.AutomationId="ExperimentalPanel">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Experimental" />
                        <TextBlock Style="{StaticResource Explain}" Text="New features that could still misbehave arrive here first, switched off. Turn one on to try it; if it causes trouble, turn it off again – no update needed." />
                        <ItemsControl ItemsSource="{Binding ExperimentalSwitches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Title}"><TextBlock Text="{Binding Title}" /></CheckBox>
                                        <TextBlock Style="{StaticResource Explain}" Text="{Binding Description}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Explain}" Margin="0,12,60,0" Text="Nothing to try right now." Visibility="{Binding HasExperimental, Converter={x:Static app:BoolVisibility.Instance}, ConverterParameter=not}" />
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
