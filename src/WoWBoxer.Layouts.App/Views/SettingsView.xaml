<UserControl x:Class="WoWBoxer.Layouts.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App">
    <UserControl.Resources>
        <Style x:Key="Setting" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Explain" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,3,60,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1100" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Game" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton Style="{StaticResource SmallSegButton}" Content="Classic Era" GroupName="game2" IsChecked="{Binding Forever, Converter={x:Static app:InvertBool.Instance}}" />
                            <RadioButton Style="{StaticResource SmallSegButton}" Content="Forever" GroupName="game2" IsChecked="{Binding Forever}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Only changes the Battle.net instructions. Window handling is the same for every client." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Windows" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding LiveApply}"><TextBlock Text="Move my WoW windows live" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="When you change the layout, open game windows move right away. Off: use Arrange now." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding RenameWindows}"><TextBlock Text="Title WoW windows with the character names" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="The game windows become &quot;WoW - name&quot; on the taskbar, for windows with a character name." />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding Animations}"><TextBlock Text="Animations" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="Windows glide into place on the map. Turn off for a calmer screen." />
                        <Button Content="Give WoW windows their title bars back" Command="{Binding RestoreFramesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                ToolTip="Undo &quot;remove title bars&quot; on every open WoW window" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="WoW client" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding GameExe, UpdateSourceTrigger=LostFocus}" ToolTip="Found automatically (a running client, the registry or the default folder)" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Used for &quot;Login screens&quot; and for the account and character hints. The WTF folder next to it is only read, never changed." />
                        <Button Content="Read accounts and characters again" Command="{Binding RefreshHintsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Battle.net" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBattleNetCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding BattleNetExe, UpdateSourceTrigger=LostFocus}" ToolTip="Found automatically; change it only if Battle.net lives somewhere unusual" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Start squad opens Battle.net if it is not running. Start it normally – not as administrator." />
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Shortcuts" />
                        <Button Content="Create a desktop shortcut for this layout" Click="OnCreateShortcut" HorizontalAlignment="Left" Margin="0,12,0,0"
                                ToolTip="One click: opens the app in the tray and starts your squad with the current layout" />
                        <TextBlock Style="{StaticResource Explain}" Text="The shortcut starts the app in the tray and begins &quot;Start squad&quot; with the layout you have open now." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Updates and privacy" />
                        <CheckBox Style="{StaticResource Setting}" IsChecked="{Binding CheckForUpdates}"><TextBlock Text="Check for updates when the app starts" /></CheckBox>
                        <TextBlock Style="{StaticResource Explain}" Text="The only network call the app makes. Updates install when you quit. No telemetry, ever." />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="24,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Help and data" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Diagnose" Command="{Binding DiagnoseCommand}" Margin="0,0,8,8"
                                    ToolTip="Writes a report (monitors, windows, admin rights, WoW display settings) and tries one placement per window" />
                            <Button Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                            <Button Content="Open layouts folder" Command="{Binding OpenLayoutsFolderCommand}" Margin="0,0,8,8" />
                            <Button Content="Show welcome screen" Command="{Binding ShowFirstRunCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Explain}" Text="Logs and reports stay on your PC, with your Windows user name hidden, so they are safe to send." />
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
