<UserControl x:Class="WoWBoxer.Layouts.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWBoxer.Layouts.App.Controls"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App">
    <!-- One main screen (v0.2.3): clients + layout on the left, the map in the middle, "Your squad" on the right,
         launch and apply in the footer. Selecting a squad row selects its window on the map and opens its details. -->
    <UserControl.Resources>
        <!-- Squad size: gold-trimmed numbers (ListBox so the selection is two-way) -->
        <Style x:Key="SizeItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,4,4" Width="31" Height="38">
                            <Border x:Name="Body" CornerRadius="5" BorderThickness="1.5" BorderBrush="#3A4560" Background="#121722">
                                <Border.Effect><DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="14" Color="#E8C66A" Opacity="0" /></Border.Effect>
                            </Border>
                            <TextBlock x:Name="Num" Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="17" Foreground="{StaticResource TextBrush}" Effect="{StaticResource HardTextShadow}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldLoBrush}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <Setter TargetName="Body" Property="Background">
                                    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A2E14" Offset="0" /><GradientStop Color="#1C170C" Offset="1" /></LinearGradientBrush></Setter.Value>
                                </Setter>
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource UiGoldBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Layout card: live mini preview + title; gold glow when active, lifts on hover -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Margin="0,0,8,8" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><TranslateTransform x:Name="Lift" /></Grid.RenderTransform>
                            <Border x:Name="Body" CornerRadius="7" BorderThickness="1.5" BorderBrush="#2E3850" Padding="7,7,7,7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1"><GradientStop Color="#1E2536" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect><DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="18" Color="#E8C66A" Opacity="0" /></Border.Effect>
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldLoBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.25" /></Storyboard></BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- WoW tooltip-style box -->
        <Style x:Key="TipBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#8E8E8E" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background">
                <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0C0F1E" Offset="0" /><GradientStop Color="#060812" Offset="1" /></LinearGradientBrush></Setter.Value>
            </Setter>
        </Style>

        <!-- Details of the selected window, shown inside its squad row. DataContext = the main view model. -->
        <DataTemplate x:Key="SlotDetails">
            <StackPanel Margin="0,8,0,0">
                <UniformGrid Columns="4" ToolTip="{Binding SlotInfo}">
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource FieldLabel}" Text="X" /><TextBox Text="{Binding SlotX, UpdateSourceTrigger=LostFocus}" ToolTip="Left edge in screen pixels" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Y" /><TextBox Text="{Binding SlotY, UpdateSourceTrigger=LostFocus}" ToolTip="Top edge in screen pixels" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Width" /><TextBox Text="{Binding SlotW, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Height" /><TextBox Text="{Binding SlotH, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </UniformGrid>
                <CheckBox Content="Always on top (floating overlay)" IsChecked="{Binding SlotOnTop}" Margin="0,8,0,0"
                          ToolTip="Keeps this window above the others – for followers floating over the main client. Applies at once, live mode on or off." />
                <CheckBox Content="Keep the exact size" IsChecked="{Binding SlotKeepSize}" Margin="0,5,0,0"
                          ToolTip="Never shorten this window to the window-shape rule" />
                <Border Style="{StaticResource TipBox}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Action bar" Foreground="{StaticResource UiGoldBrush}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding SlotBarBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SlotBarText}" Foreground="#E4E4E4" TextWrapping="Wrap" MaxWidth="290" FontSize="12" AutomationProperties.AutomationId="SlotBarText" />
                        </StackPanel>
                        <TextBlock Text="{Binding SlotUiScaleHint}" Foreground="#C8C8C8" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding SlotUiScaleHint, Converter={x:Static app:BoolVisibility.Instance}}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoFitActionBar}" Margin="0,6,0,0" AutomationProperties.Name="Auto-fit action bar"
                                  ToolTip="Sets WoW's UI Scale for you so the whole bar fits in every window – whenever the clients of this WoW install are closed">
                            <TextBlock Text="Auto-fit action bar" Foreground="#E4E4E4" FontSize="12" />
                        </CheckBox>
                        <TextBlock Foreground="#1EFF00" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Only while all clients are closed: WoW shares one UI Scale and saves it when a client closes." />
                        <WrapPanel Margin="0,5,0,0">
                            <Button Content="Fix action bar" Command="{Binding FixUiScaleCommand}" Margin="0,0,6,6" Padding="10,4" FontSize="12" AutomationProperties.AutomationId="FixUiScale"
                                    ToolTip="Sets the UI Scale now (all clients closed), or tells you what to set in game" />
                            <Button Content="Shorten window instead" Command="{Binding FitActionBarCommand}" Margin="0,0,6,6" Padding="10,4" FontSize="12"
                                    ToolTip="Shortens this window just enough for a 4:3 picture (keeps its width); no game setting changes" />
                            <Button Content="UI Scale off" Command="{Binding ResetUiScaleCommand}" Margin="0,0,6,6" Padding="10,4" FontSize="12"
                                    ToolTip="Turns Use UI Scale off again (and Auto-fit). Only while all clients are closed." />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Squad row container: gold frame when selected; selecting a row selects its window on the map -->
        <Style x:Key="SquadItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Margin="0,0,0,7" Padding="6,8,10,8" BorderThickness="1" BorderBrush="#2E3850"
                                AllowDrop="True" PreviewDragOver="OnRowDragOver" PreviewDragEnter="OnRowDragOver" DragLeave="OnRowDragLeave" PreviewDrop="OnRowDrop" Tag="{Binding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1C2333" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <ContentPresenter />
                                <ContentControl x:Name="Details" Visibility="Collapsed" Focusable="False" ContentTemplate="{StaticResource SlotDetails}"
                                                Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="24,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- typing in a row's name box selects that row -->
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="IsSelected" Value="True" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Left: clients, layout, saved layout, window rules ===== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="16,14,10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepLabel}" Text="I  ·  HOW MANY CLIENTS?" />
                        <ListBox Margin="0,10,0,0" ItemsSource="{Binding ClientCounts}" SelectedItem="{Binding ClientCount}" ItemContainerStyle="{StaticResource SizeItem}"
                                 ToolTip="How many WoW clients you play at once. The layout adapts instantly (Ctrl+ and Ctrl− work too).">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="16,14,8,8" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepLabel}" Text="II  ·  PICK A LAYOUT" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CardButton}" Command="{Binding Apply}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Title}"
                                            ToolTip="{Binding Blurb}">
                                        <StackPanel>
                                            <Grid>
                                                <Border Height="48" CornerRadius="4" Background="#05070B" BorderBrush="#3A4560" BorderThickness="1" ClipToBounds="True">
                                                    <c:LayoutCanvas Compact="True" Profile="{Binding Preview}" IsHitTestVisible="False"
                                                                    Monitors="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </Border>
                                                <Grid Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                      Visibility="{Binding IsSelected, Converter={x:Static app:BoolVisibility.Instance}}">
                                                    <Ellipse Fill="#1C170C" Stroke="{StaticResource GoldHiBrush}" StrokeThickness="1.5" />
                                                    <Path Data="M5,9 L7.8,11.8 L13,6.5" Stroke="{StaticResource UiGoldBrush}" StrokeThickness="2" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" Foreground="{StaticResource ParchmentBrush}"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Unavailable}" FontSize="10.5" Foreground="{StaticResource WarnBrush}" Margin="0,2,0,0" HorizontalAlignment="Center"
                                                       Visibility="{Binding Unavailable, Converter={x:Static app:BoolVisibility.Instance}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepLabel}" Text="SAVED LAYOUT" />
                        <ComboBox Margin="0,10,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ToolTip="Your saved layouts for this game. Every change is saved automatically.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <Button Content="Save as…" Command="{Binding SaveAsCommand}" Margin="0,0,5,0" Padding="4,6" FontSize="12" ToolTip="Keep this as a new layout" />
                            <Button Content="Rename" Command="{Binding RenameCommand}" Margin="0,0,5,0" Padding="4,6" FontSize="12" />
                            <Button Content="More ▾" Padding="4,6" FontSize="12" Click="OnMore" ToolTip="Share, import, capture, delete">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy layout code (WBX1:)" Command="{Binding CopyCodeCommand}" />
                                        <MenuItem Header="Paste a layout code…" Command="{Binding ImportCodeCommand}" />
                                        <MenuItem Header="Open a layout file…" Command="{Binding ImportFileCommand}" />
                                        <MenuItem Header="Save as a file…" Command="{Binding ExportFileCommand}" />
                                        <MenuItem Header="Capture my current WoW windows" Command="{Binding CaptureCommand}" />
                                        <MenuItem Header="Delete this layout" Command="{Binding DeleteCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepLabel}" Text="WINDOW RULES" />
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,4" Text="Narrowest window shape" />
                        <ComboBox ItemsSource="{Binding AspectChoices}" SelectedItem="{Binding SelectedAspect}"
                                  ToolTip="Windows narrower than this are shortened (never stretched). 4:3 shows Classic's whole action bar." />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CoverTaskbar}" Margin="0,12,0,0"
                                  ToolTip="Use the whole monitor, including the strip where the taskbar sits">
                            <TextBlock Text="Cover the taskbar area" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Text="{Binding TaskbarHint}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Borderless}" Margin="0,10,0,0"
                                  ToolTip="Off is safest: in our tests WoW sometimes drew its UI at the wrong size after the frame was removed">
                            <TextBlock Text="Remove title bars" />
                        </CheckBox>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Middle: the map ===== -->
        <ContentControl Grid.Column="2" Style="{StaticResource OrnatePanel}" Padding="18,14,18,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Style="{StaticResource StepLabel}" Text="III  ·  YOUR SCREENS" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LayoutTitle}" Style="{StaticResource H2}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FullActionBar}" Margin="0,0,16,4" VerticalAlignment="Center"
                              ToolTip="Shortens follower windows just enough that WoW shows the whole Classic action bar (a 4:3 picture)">
                        <TextBlock Text="Full action bar" Foreground="{StaticResource TextBrush}" />
                    </CheckBox>
                    <CheckBox x:Name="AllMonitors" Style="{StaticResource Switch}" Margin="0,0,16,4" VerticalAlignment="Center"
                              ToolTip="Show every monitor, so you can drag a window onto another screen">
                        <TextBlock Text="All monitors" Foreground="{StaticResource TextBrush}" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LiveApply}" Margin="0,0,16,4" VerticalAlignment="Center"
                              ToolTip="On: your open WoW windows move as soon as you change the layout. Off: use Apply to open windows.">
                        <TextBlock Text="Move WoW windows live" Foreground="{StaticResource TextBrush}" />
                    </CheckBox>
                </WrapPanel>

                <Grid Grid.Row="2" Margin="0,6,0,4">
                    <c:LayoutCanvas x:Name="Canvas" Profile="{Binding Current}" Monitors="{Binding Monitors}" LiveSlots="{Binding LiveSlots}" UiScale="{Binding UiScaleEffective}"
                                    SelectedIndex="{Binding SelectedSlotIndex}" Animate="{Binding Animations}"
                                    ShowAllMonitors="{Binding IsChecked, ElementName=AllMonitors}" />
                    <!-- Auto-fit notice -->
                    <Border Style="{StaticResource TipBox}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" MaxWidth="460"
                            Visibility="{Binding UiScaleNotice, Converter={x:Static app:BoolVisibility.Instance}}">
                        <TextBlock Text="{Binding UiScaleNotice}" Foreground="#1EFF00" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="UiScaleNotice" />
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                           Text="Drag a window to move it · drop it on another to swap · gold handles resize · Alt places freely · arrow keys nudge · Tab selects the next window · solid dot = measured on the open WoW window, ring = planned · pin = always on top" />
            </Grid>
        </ContentControl>

        <!-- ===== Right: your squad ===== -->
        <ContentControl Grid.Column="4" Style="{StaticResource OrnatePanel}" Padding="16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource SmallSegButton}" Content="Classic Era" GroupName="game"
                                         IsChecked="{Binding Forever, Converter={x:Static app:InvertBool.Instance}}" ToolTip="Only this game's windows are arranged; each game has its own layouts" />
                            <RadioButton Style="{StaticResource SmallSegButton}" Content="Forever" GroupName="game" IsChecked="{Binding Forever}"
                                         ToolTip="Only this game's windows are arranged; each game has its own layouts" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource H2}" FontSize="18" Text="Your squad" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,8" TextWrapping="Wrap" Text="{Binding SquadHint}" />
                </StackPanel>

                <!-- tools, launch checklist and activity -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Expander Header="Tools" Foreground="{StaticResource TextBrush}">
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Identify all" Command="{Binding IdentifyCommand}" Margin="0,0,6,6" Padding="10,5" FontSize="12" ToolTip="Show each window's number on top of it for a few seconds (Ctrl+I)" />
                        <Button Content="Give title bars back" Command="{Binding RestoreFramesCommand}" Margin="0,0,6,6" Padding="10,5" FontSize="12" />
                        <Button Content="Diagnose…" Command="{Binding DiagnoseCommand}" Margin="0,0,6,6" Padding="10,5" FontSize="12"
                                ToolTip="Write a report (monitors, windows, admin rights, WoW display settings) you can send when you ask for help" />
                        <Button Content="Close clients I started" Command="{Binding CloseMineCommand}" Margin="0,0,6,6" Padding="10,5" FontSize="12"
                                ToolTip="Closes only the login screens this app opened – never your own clients" />
                    </WrapPanel>
                    </Expander>
                    <Expander Header="Start checklist" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" IsExpanded="{Binding IsWatching, Mode=OneWay}">
                        <ItemsControl ItemsSource="{Binding Checklist}" Margin="4,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,5">
                                        <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                                            <Ellipse x:Name="Ring" Stroke="{StaticResource GoldLoBrush}" StrokeThickness="1.5" />
                                            <Path x:Name="Tick" Data="M4,8 L7,11 L12,5" Stroke="{StaticResource OkBrush}" StrokeThickness="2" Opacity="0" />
                                        </Grid>
                                        <TextBlock x:Name="Label" Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource OkBrush}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="Activity" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}">
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Top" Style="{StaticResource LinkButton}" Content="Open logs" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Right" />
                            <Border Style="{StaticResource TipBox}" Height="150">
                                <ListBox x:Name="StatusList" ItemsSource="{Binding Status.Lines}" FontFamily="{StaticResource MonoFont}" FontSize="11">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,1" /></ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Foreground="{Binding Brush}">
                                                <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#6B6F7A" /> <Run Text="{Binding Message, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </Expander>
                </StackPanel>

                <!-- one row per window; drag ⋮⋮ to reorder; the selected row shows the window's details -->
                <ListBox x:Name="PartyList" ItemsSource="{Binding Party}" SelectedIndex="{Binding SelectedSlotIndex}" ItemContainerStyle="{StaticResource SquadItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Squad rows">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- drag handle -->
                                <Border Background="Transparent" Cursor="SizeAll" Tag="{Binding}" ToolTip="Drag to move this character (and its window) to another slot"
                                        PreviewMouseLeftButtonDown="OnHandleDown" PreviewMouseMove="OnHandleMove" PreviewMouseLeftButtonUp="OnHandleUp">
                                    <TextBlock Text="⋮⋮" FontSize="16" Foreground="{StaticResource GoldLoBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
                                </Border>
                                <Grid Grid.Column="1" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="2.2">
                                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#232B3E" Offset="0" /><GradientStop Color="#0B0E14" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource UiGoldBrush}" Effect="{StaticResource HardTextShadow}" />
                                </Grid>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="6" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource DisplayFont}" Foreground="{Binding ClassBrush}"
                                                     ToolTip="The character playing in this slot. Press Enter to save." />
                                            <TextBlock Text="{Binding Title}" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="#80A79F8A"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       Visibility="{Binding Name, Converter={x:Static app:BoolVisibility.Instance}, ConverterParameter=not}" />
                                        </Grid>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding Classes}" SelectedItem="{Binding Class}" ToolTip="The class of this character – set it once; the app never guesses">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" FontSize="12"
                                                  ToolTip="The WoW account this slot logs in with (from your WTF folder). Stays on this PC.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static app:EmptyAs.Instance}, ConverterParameter=WoW account: not set}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <!-- pin: always on top (gold = as wanted, red = being put right) -->
                                            <Viewbox Width="13" Height="13" Margin="0,0,5,0" ToolTip="{Binding PinText}"
                                                     Visibility="{Binding ShowPin, Converter={x:Static app:BoolVisibility.Instance}}">
                                                <Canvas Width="16" Height="16">
                                                    <Path Data="M7,9 L2,14" Stroke="{Binding PinBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Ellipse Canvas.Left="6" Canvas.Top="2" Width="8" Height="8" Fill="{Binding PinBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <Border CornerRadius="9" BorderThickness="1" Padding="7,2" Margin="0,0,5,0"
                                                    BorderBrush="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" Background="#40000000">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" />
                                                </StackPanel>
                                            </Border>
                                            <Button Style="{StaticResource LinkButton}" Content="Identify" Command="{Binding Identify}" FontSize="11.5" ToolTip="Show this slot's number on its WoW window" />
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="2,4,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Use" Command="{Binding UseHint}" FontSize="11"
                                                ToolTip="Use this character's name for the slot" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="A hint from the WTF folder (the character folder WoW wrote last) – not a fact">
                                            <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" /> <Run Text="·" /> <Run Text="{Binding HintText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ContentControl>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Grid.ColumnSpan="5" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,9">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1A2030" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush></Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="START WITH" Style="{StaticResource StepLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Style="{StaticResource SmallSegButton}" Content="Battle.net" GroupName="launch" IsChecked="{Binding LaunchViaBattleNet}" VerticalAlignment="Center"
                                 ToolTip="Opens Battle.net; you press Play once per account (choose the account in Battle.net each time)" />
                    <RadioButton Style="{StaticResource SmallSegButton}" Content="Login screens" GroupName="launch" IsChecked="{Binding LaunchLoginScreens}" VerticalAlignment="Center" Margin="0,0,14,0"
                                 ToolTip="Opens one WoW login screen per missing client; you log in to each yourself. Nothing is typed for you." />
                    <Button Content="Stop watching" Command="{Binding StopCommand}" Margin="0,0,10,0" Padding="12,8"
                            Visibility="{Binding IsWatching, Converter={x:Static app:BoolVisibility.Instance}}" />
                    <Button Command="{Binding ArrangeCommand}" Margin="0,0,10,0" Padding="14,8"
                            ToolTip="Move the WoW windows that are open now into this layout (F5)">
                        <TextBlock Text="APPLY TO OPEN WINDOWS" />
                    </Button>
                    <Button Style="{StaticResource EnterWorldButton}" Command="{Binding StartFromSetupCommand}" FontSize="16" Padding="22,8"
                            ToolTip="Start the clients (Battle.net or login screens) and place each WoW window as it opens (Ctrl+Enter). You log in and press Play yourself.">
                        <TextBlock Text="▶  START SQUAD" />
                    </Button>
                </StackPanel>
                <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="14,8" ToolTip="Undo the last change (Ctrl+Z)" />
                <Button Content="Reset to preset" Command="{Binding ResetCommand}" Padding="14,8" ToolTip="Put every window back where the chosen layout puts it" />
                <TextBlock Text="{Binding SavedText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,10,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
