<UserControl x:Class="WoWBoxer.Layouts.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWBoxer.Layouts.App.Controls"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App">
    <!-- Plug and play (v0.2.4): clients, layout and monitors on the left, the map in the middle, "Your squad" on the right
         (one compact row per window, grouped by party above 5 clients, ▾ for details), one primary button in the footer
         that follows the squad's state. v0.4.0: 1–10 clients and a Monitors choice (v0.4.2: the layout cards are back, owner preferred them). -->
    <UserControl.Resources>
        <!-- Squad size: gold-trimmed numbers (ListBox so the selection is two-way) -->
        <Style x:Key="SizeItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,5,5" Height="36">
                            <Border x:Name="Body" CornerRadius="5" BorderThickness="1.5" BorderBrush="#3A4560" Background="#121722">
                                <Border.Effect><DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="14" Color="#E8C66A" Opacity="0" /></Border.Effect>
                            </Border>
                            <TextBlock x:Name="Num" Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="17" Foreground="{StaticResource TextBrush}" Effect="{StaticResource HardTextShadow}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldLoBrush}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <Setter TargetName="Body" Property="Background">
                                    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A2E14" Offset="0" /><GradientStop Color="#1C170C" Offset="1" /></LinearGradientBrush></Setter.Value>
                                </Setter>
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource UiGoldBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Layout card: live mini preview + title; gold glow when active, lifts on hover -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Margin="0,0,8,8" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><TranslateTransform x:Name="Lift" /></Grid.RenderTransform>
                            <Border x:Name="Body" CornerRadius="7" BorderThickness="1.5" BorderBrush="#2E3850" Padding="7,7,7,7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1"><GradientStop Color="#1E2536" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect><DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="18" Color="#E8C66A" Opacity="0" /></Border.Effect>
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldLoBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.25" /></Storyboard></BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Advanced editing ribbon ===== -->
        <Style x:Key="RibbonGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="RibbonCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style x:Key="RibbonIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="#14FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter Property="Foreground" Value="#FFE45C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#40E8C66A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="#14FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#55C9A24A" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter Property="Foreground" Value="#FFE9A8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonField" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,3,0" />
        </Style>
        <Style x:Key="RibbonNumber" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="4,1" />
        </Style>
        <!-- the map header's "Advanced editing" switch -->
        <Style x:Key="EditModeToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplaySemiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" CornerRadius="4" BorderThickness="1" BorderBrush="#6B5422" Background="#1AFFFFFF" Padding="9,3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,12 L2,14 L4,14 L12,6 L10,4 Z M9,5 L11,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" Width="14" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#55C9A24A" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <Setter Property="Foreground" Value="#FFE9A8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- Details of a squad row's window (open with ▾). DataContext = the main view model; the open row is the selected one. -->
        <DataTemplate x:Key="SlotDetails">
            <StackPanel Margin="0,10,0,2">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="6" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Class" />
                        <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SlotClass}" ToolTip="The class of this character – set it once; the app never guesses"
                                  AutomationProperties.Name="Class">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedMember}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="WoW account" />
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" FontSize="12" AutomationProperties.Name="WoW account"
                                  ToolTip="The WoW account this slot logs in with (from your WTF folder). Stays on this PC.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static app:EmptyAs.Instance}, ConverterParameter=Not set}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <DockPanel Margin="0,8,0,0" DataContext="{Binding SelectedMember}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Role (optional)" Width="132" VerticalAlignment="Center" Margin="0" />
                    <ComboBox ItemsSource="{Binding CombatRoles}" SelectedItem="{Binding CombatRole}" FontSize="12" Width="132" HorizontalAlignment="Left"
                              AutomationProperties.Name="Role" ToolTip="Tank, healer or damage – only used for ready-made window-swap orders (Settings › Advanced)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static app:EmptyAs.Instance}, ConverterParameter=Not set}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <DockPanel Margin="2,5,0,0" DataContext="{Binding SelectedMember}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Use name" Command="{Binding UseHint}" FontSize="11"
                            ToolTip="Use this character's name for the slot" />
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding HintText}"
                               ToolTip="A hint from the WTF folder (the character folder WoW wrote last) – not a fact" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Identify" Command="{Binding SelectedMember.Identify}" Padding="10,3" FontSize="12"
                            ToolTip="Show this slot's number on its WoW window for a few seconds" />
                    <CheckBox Content="Always on top" IsChecked="{Binding SlotOnTop}" VerticalAlignment="Center"
                              ToolTip="Keeps this window above the others – for followers floating over the main client. Applies at once and stays on." />
                </DockPanel>
                <UniformGrid Columns="4" Margin="0,8,0,0" ToolTip="{Binding SlotInfo}">
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource FieldLabel}" Text="X" /><TextBox Text="{Binding SlotX, UpdateSourceTrigger=LostFocus}" ToolTip="Left edge in screen pixels" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Y" /><TextBox Text="{Binding SlotY, UpdateSourceTrigger=LostFocus}" ToolTip="Top edge in screen pixels" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Width" /><TextBox Text="{Binding SlotW, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Height" /><TextBox Text="{Binding SlotH, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </UniformGrid>
                <CheckBox Content="Keep the exact size" IsChecked="{Binding SlotKeepSize}" Margin="0,6,0,0"
                          ToolTip="Never shorten this window to the window-shape rule (Settings › Window rules)" />
                <Border Style="{StaticResource TipBox}" Margin="0,8,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding SlotBarBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SlotBarText}" Foreground="#E4E4E4" TextWrapping="Wrap" MaxWidth="290" FontSize="12" AutomationProperties.AutomationId="SlotBarText" />
                        </StackPanel>
                        <TextBlock Text="{Binding SlotUiScaleHint}" Foreground="#1EFF00" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding SlotUiScaleHint, Converter={x:Static app:BoolVisibility.Instance}}" />
                        <Button Style="{StaticResource LinkButton}" Content="Shorten this window instead" Command="{Binding FitActionBarCommand}" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Left"
                                ToolTip="Shortens this window just enough for a 4:3 picture (keeps its width); no game setting changes" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Squad row: one compact line; ▾ opens the details. Gold frame when selected (its window is selected on the map). -->
        <Style x:Key="SquadItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Margin="0,0,0,6" Padding="4,6,8,6" BorderThickness="1" BorderBrush="#2E3850"
                                AllowDrop="True" PreviewDragOver="OnRowDragOver" PreviewDragEnter="OnRowDragOver" DragLeave="OnRowDragLeave" PreviewDrop="OnRowDrop" Tag="{Binding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1C2333" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <ContentPresenter />
                                <ContentControl x:Name="Details" Visibility="Collapsed" Focusable="False" ContentTemplate="{StaticResource SlotDetails}"
                                                Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="22,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small round "?" with the help text as its tooltip -->
        <Style x:Key="HelpMark" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldLoBrush}" />
            <Setter Property="Background" Value="#121722" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>

        <!-- small icon button (Undo, Reset) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="372" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Left: clients, layout, saved layout ===== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="16,14,10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepLabel}" Text="I  ·  HOW MANY CLIENTS?" />
                        <ListBox Margin="0,10,0,0" ItemsSource="{Binding ClientCounts}" SelectedItem="{Binding ClientCount}" ItemContainerStyle="{StaticResource SizeItem}"
                                 AutomationProperties.AutomationId="ClientCount"
                                 ToolTip="How many WoW clients you play at once: 1–5 is one party, 6–10 two parties (the top row is party 1). 1 = one normal window filling the screen, when you play a single character. The layout adapts instantly (Ctrl+ and Ctrl− work too).">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,1,0,0" Text="1–5: one party  ·  6–10: two parties" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource OrnatePanel}" Padding="16,14,12,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepLabel}" Text="II  ·  PICK A LAYOUT" />
                        <!-- every layout as a card with a live mini preview for the current clients and monitors; click to pick -->
                        <ItemsControl Margin="0,10,-8,0" ItemsSource="{Binding Layouts}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CardButton}" Command="{Binding Apply}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Blurb}">
                                        <StackPanel>
                                            <Grid>
                                                <Border Height="48" CornerRadius="4" Background="#05070B" BorderBrush="#3A4560" BorderThickness="1" ClipToBounds="True">
                                                    <c:LayoutCanvas Compact="True" Profile="{Binding Preview}" Monitors="{Binding Monitors}" Screens="{Binding Screens}" IsHitTestVisible="False" />
                                                </Border>
                                                <Grid Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                      Visibility="{Binding IsSelected, Converter={x:Static app:BoolVisibility.Instance}}">
                                                    <Ellipse Fill="#1C170C" Stroke="{StaticResource GoldHiBrush}" StrokeThickness="1.5" />
                                                    <Path Data="M5,9 L7.8,11.8 L13,6.5" Stroke="{StaticResource UiGoldBrush}" StrokeThickness="2" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" Foreground="{StaticResource ParchmentBrush}"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding SelectedLayout.Blurb}" />
                        <!-- 6–10 clients on one monitor: the parties share it; flip the split -->
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding HasSplit, Converter={x:Static app:BoolVisibility.Instance}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Flip" Command="{Binding FlipSplitCommand}" FontSize="12"
                                    AutomationProperties.AutomationId="FlipSplit" ToolTip="Side by side ⇄ one above the other (the app starts with the one that gives bigger windows)" />
                            <TextBlock Text="{Binding SplitText}" FontSize="12" Foreground="{StaticResource ParchmentBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="SplitText" />
                        </DockPanel>
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding FollowersOnSecond}" AutomationProperties.AutomationId="FollowersOnSecond"
                                  Visibility="{Binding CanFollowersOnSecond, Converter={x:Static app:BoolVisibility.Instance}}"
                                  ToolTip="The followers' row floats on monitor 2 instead of over the main">
                            <TextBlock Text="Followers on monitor 2" FontSize="12" />
                        </CheckBox>
                        <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="{Binding LayoutAdvice}"
                                   AutomationProperties.AutomationId="LayoutAdvice" Visibility="{Binding LayoutAdvice, Converter={x:Static app:BoolVisibility.Instance}}" />
                    </StackPanel>
                </ContentControl>

                <!-- Monitors: a separate choice right below the layout (only with 2+ monitors connected) -->
                <Border Margin="6,10,6,0" Padding="14,10,14,12" CornerRadius="8" BorderBrush="{StaticResource GoldLoBrush}" BorderThickness="1"
                        Visibility="{Binding ShowMonitors, Converter={x:Static app:BoolVisibility.Instance}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#141A27" Offset="0" /><GradientStop Color="#0D111A" Offset="1" /></LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource GoldHiBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource StepLabel}" Text="MONITORS" VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding MonitorCounts}" SelectedItem="{Binding SelectedMonitorCount}"
                                  AutomationProperties.AutomationId="MonitorCount" AutomationProperties.Name="Monitors"
                                  ToolTip="How many of your monitors the layout uses. Your screens (the map) shows exactly these, numbered 1, 2 …; the main goes on 1.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Visibility="{Binding ShowMonitorSets, Converter={x:Static app:BoolVisibility.Instance}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,3" Text="Which ones" />
                            <ComboBox ItemsSource="{Binding MonitorSets}" SelectedItem="{Binding SelectedMonitorSet}" AutomationProperties.AutomationId="MonitorSet" AutomationProperties.Name="Which monitors"
                                      ToolTip="Which monitors to use (the first one holds the main)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- saved layout: compact dropdown, Save as, and the rest in ⋯ -->
                <ContentControl Style="{StaticResource OrnatePanel}" Padding="16,12" Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="⋯" Click="OnMore" Margin="6,0,0,0" Padding="10,4" FontSize="14" AutomationProperties.Name="More layout actions"
                                ToolTip="Rename, delete, share, import, capture">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename…" Command="{Binding RenameCommand}" />
                                    <MenuItem Header="Delete this layout" Command="{Binding DeleteCommand}" />
                                    <Separator />
                                    <MenuItem Header="Copy layout code (WBX1:)" Command="{Binding CopyCodeCommand}" />
                                    <MenuItem Header="Paste a layout code…" Command="{Binding ImportCodeCommand}" />
                                    <MenuItem Header="Open a layout file…" Command="{Binding ImportFileCommand}" />
                                    <MenuItem Header="Save as a file…" Command="{Binding ExportFileCommand}" />
                                    <MenuItem Header="Capture my current WoW windows" Command="{Binding CaptureCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Save as…" Command="{Binding SaveAsCommand}" Margin="6,0,0,0" Padding="10,4" FontSize="12" ToolTip="Keep this as a new layout" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Saved layout"
                                  ToolTip="Your saved layouts. Every change is saved automatically.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Middle: the map ===== -->
        <ContentControl Grid.Column="2" Style="{StaticResource OrnatePanel}" Padding="18,14,18,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource HelpMark}" VerticalAlignment="Center" AutomationProperties.Name="Map help">
                        <Border.ToolTip>
                            <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                       Text="Drag a window to move it · drop it on another to swap · gold handles resize · Alt places freely · arrow keys nudge · Tab selects the next window. Moving or resizing a window of a preset makes it Custom (kept as a draft). ADVANCED EDITING: select several (Ctrl/Shift+click, drag a box, Ctrl+A), move them together, match size (Alt+Z), align, distribute, fill a row or column; Ctrl+Z / Ctrl+Y undo and redo. The dot shows the action bar (solid = measured on the open game window, ring = planned). Pin = always on top. The ring round each number: pulsing = awaiting its WoW window, green = connected." />
                        </Border.ToolTip>
                        <TextBlock Text="?" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GoldHiBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource EditModeToggle}" IsChecked="{Binding AdvancedEditing}" Margin="0,0,10,0" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="AdvancedEditing" AutomationProperties.Name="Advanced editing"
                                  ToolTip="Advanced editing: select several windows (Ctrl/Shift+click, drag a box, Ctrl+A), move them together, match sizes, align, distribute, fill a row or column">
                        <TextBlock Text="ADVANCED EDITING" />
                    </ToggleButton>
                    <TextBlock Style="{StaticResource StepLabel}" Text="III  ·  YOUR SCREENS" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LayoutTitle}" Style="{StaticResource H2}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- ===== Advanced editing: a slim ribbon above the map (shortcuts work only inside the app) ===== -->
                <Border Grid.Row="1" x:Name="EditRibbon" Margin="0,8,0,0" Padding="8,5" CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource LineSoftBrush}"
                        AutomationProperties.AutomationId="EditRibbon" AutomationProperties.Name="Advanced editing toolbar">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E6171B25" Offset="0" /><GradientStop Color="#E60D1017" Offset="1" /></LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform><TranslateTransform x:Name="RibbonShift" /></Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AdvancedEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <!-- select -->
                            <StackPanel Style="{StaticResource RibbonGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding SelectAllCommand}" ToolTip="Select all windows (Ctrl+A)" AutomationProperties.Name="Select all">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1.5,1.5 H14.5 V14.5 H1.5 Z" StrokeDashArray="2 1.5" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding ClearSelectionCommand}" ToolTip="Clear the selection (Esc)" AutomationProperties.Name="Clear selection">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M3,3 L13,13 M13,3 L3,13" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="Select" />
                            </StackPanel>
                            <!-- match size -->
                            <StackPanel Style="{StaticResource RibbonGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding SameWidthCommand}" ToolTip="Same width as the reference (gold outline); top-left corners stay" AutomationProperties.Name="Same width">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M2,5 H14 M2,11 H14 M2,3 V7 M14,3 V7 M2,9 V13 M14,9 V13" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding SameHeightCommand}" ToolTip="Same height as the reference; top-left corners stay" AutomationProperties.Name="Same height">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M5,2 V14 M11,2 V14 M3,2 H7 M3,14 H7 M9,2 H13 M9,14 H13" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding SameSizeCommand}" ToolTip="Same size as the reference (Alt+Z); top-left corners stay" AutomationProperties.Name="Same size">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1.5,1.5 H8.5 V8.5 H1.5 Z M7.5,7.5 H14.5 V14.5 H7.5 Z" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="Match size" />
                            </StackPanel>
                            <!-- align -->
                            <StackPanel Style="{StaticResource RibbonGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding AlignCommand}" CommandParameter="Left" ToolTip="Align left edges (to the reference, or to the monitor for one window)" AutomationProperties.Name="Align left">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M2,1 V15 M4,3 H13 V7 H4 Z M4,9 H9 V13 H4 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding AlignCommand}" CommandParameter="Center" ToolTip="Align centres horizontally" AutomationProperties.Name="Align centre">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M8,1 V15 M3,3 H13 V7 H3 Z M5,9 H11 V13 H5 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding AlignCommand}" CommandParameter="Right" ToolTip="Align right edges" AutomationProperties.Name="Align right">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M14,1 V15 M3,3 H12 V7 H3 Z M7,9 H12 V13 H7 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding AlignCommand}" CommandParameter="Top" ToolTip="Align top edges" AutomationProperties.Name="Align top">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1,2 H15 M3,4 V13 H7 V4 Z M9,4 V9 H13 V4 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding AlignCommand}" CommandParameter="Middle" ToolTip="Align middles vertically" AutomationProperties.Name="Align middle">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1,8 H15 M3,3 V13 H7 V3 Z M9,5 V11 H13 V5 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding AlignCommand}" CommandParameter="Bottom" ToolTip="Align bottom edges" AutomationProperties.Name="Align bottom">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1,14 H15 M3,3 V12 H7 V3 Z M9,7 V12 H13 V7 Z" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="Align" />
                            </StackPanel>
                            <!-- distribute and fill -->
                            <StackPanel Style="{StaticResource RibbonGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding DistributeHorizontallyCommand}" ToolTip="Distribute horizontally: equal gaps (3+ windows; the outer ones stay)" AutomationProperties.Name="Distribute horizontally">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1,2 V14 M15,2 V14 M6,4 H10 V12 H6 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding DistributeVerticallyCommand}" ToolTip="Distribute vertically: equal gaps (3+ windows)" AutomationProperties.Name="Distribute vertically">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M2,1 H14 M2,15 H14 M4,6 H12 V10 H4 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding FillRowCommand}" ToolTip="Fill row: equal size, edge to edge across the monitor's usable width, in their order" AutomationProperties.Name="Fill row">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1,4 H5 V12 H1 Z M6,4 H10 V12 H6 Z M11,4 H15 V12 H11 Z" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding FillColumnCommand}" ToolTip="Fill column: equal size, edge to edge down the monitor's usable height, in their order" AutomationProperties.Name="Fill column">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M4,1 H12 V5 H4 Z M4,6 H12 V10 H4 Z M4,11 H12 V15 H4 Z" />
                                    </Button>
                                    <TextBox Text="{Binding FillGap, UpdateSourceTrigger=LostFocus}" Width="34" FontSize="11.5" Padding="3,1" VerticalAlignment="Center" Margin="4,0,0,0"
                                             ToolTip="Gap between windows for Fill row / Fill column, in pixels (0 = edge to edge)" AutomationProperties.Name="Fill gap" />
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding Fit43Command}" ToolTip="Fit 4:3: the whole Classic action bar fits (keeps width and top-left; shorter if it would leave the monitor)" AutomationProperties.Name="Fit 4:3">
                                        <TextBlock Text="4:3" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="Distribute · fill (gap px) · 4:3" />
                            </StackPanel>
                            <!-- options -->
                            <StackPanel Style="{StaticResource RibbonGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource RibbonToggle}" IsChecked="{Binding SwapOnDrop}" ToolTip="Swap when dropped on another window (off: windows can sit next to or partly over each other)" AutomationProperties.Name="Swap when dropped on another window">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M2,5 H12 M9,2 L12,5 L9,8 M14,11 H4 M7,8 L4,11 L7,14" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonToggle}" IsChecked="{Binding SnapEnabled}" ToolTip="Snap to edges, monitors and the grid (Alt while dragging does the opposite)" AutomationProperties.Name="Snap">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M4,2 V8 A4,4 0 0 0 12,8 V2 M2,2 H6 M10,2 H14" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonToggle}" IsChecked="{Binding ShowGrid}" ToolTip="Show grid (twelfths of each monitor: halves, thirds, quarters)" AutomationProperties.Name="Show grid">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M1.5,1.5 H14.5 V14.5 H1.5 Z M6,1.5 V14.5 M10.5,1.5 V14.5 M1.5,6 H14.5 M1.5,10.5 H14.5" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonToggle}" IsChecked="{Binding LockAspect}" ToolTip="Lock aspect ratio while resizing" AutomationProperties.Name="Lock aspect ratio">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M4,7.5 H12 V14 H4 Z M6,7.5 V5 A2,2 0 0 1 10,5 V7.5" />
                                    </ToggleButton>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="Swap · snap · grid · lock" />
                            </StackPanel>
                            <!-- undo / redo -->
                            <StackPanel Style="{StaticResource RibbonGroup}" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M6,3 L2,7 L6,11 M2,7 H10 A4,4 0 0 1 10,15 H7" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                                        <Path Style="{StaticResource RibbonIcon}" Data="M10,3 L14,7 L10,11 M14,7 H6 A4,4 0 0 0 6,15 H9" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="Undo" />
                            </StackPanel>
                        </WrapPanel>
                        <!-- the selection: X / Y / W / H (blank where they differ) -->
                        <DockPanel Margin="2,4,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource RibbonField}" Text="X" />
                                <TextBox Style="{StaticResource RibbonNumber}" Text="{Binding SelX, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Selection X" ToolTip="Left edge in pixels (all selected windows)" />
                                <TextBlock Style="{StaticResource RibbonField}" Text="Y" />
                                <TextBox Style="{StaticResource RibbonNumber}" Text="{Binding SelY, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Selection Y" ToolTip="Top edge in pixels" />
                                <TextBlock Style="{StaticResource RibbonField}" Text="W" />
                                <TextBox Style="{StaticResource RibbonNumber}" Text="{Binding SelW, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Selection width" ToolTip="Width in pixels" />
                                <TextBlock Style="{StaticResource RibbonField}" Text="H" />
                                <TextBox Style="{StaticResource RibbonNumber}" Text="{Binding SelH, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Selection height" ToolTip="Height in pixels" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectionText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="SelectionText" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <c:LayoutCanvas x:Name="Canvas" Profile="{Binding Placed}" MainSlotMarks="{Binding MainSlotMarks}" Monitors="{Binding Monitors}" Screens="{Binding ChosenScreens}" LiveSlots="{Binding LiveSlots}" UiScale="{Binding UiScaleEffective}"
                                    SlotStates="{Binding SlotStates}" SelectedIndex="{Binding SelectedSlotIndex}" Animate="{Binding Animations}"
                                    AdvancedEditing="{Binding AdvancedEditing}" SwapOnDrop="{Binding SwapOnDrop}" SnapEnabled="{Binding SnapEnabled}" ShowGrid="{Binding ShowGrid}"
                                    LockAspect="{Binding LockAspect}" SelectedIndices="{Binding SelectedIndices, Mode=TwoWay}" AutomationProperties.AutomationId="LayoutMap" />
                    <!-- window swap is on but a party has no main slot yet -->
                    <Border Style="{StaticResource TipBox}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" MaxWidth="520"
                            Visibility="{Binding MainSlotHint, Converter={x:Static app:BoolVisibility.Instance}}">
                        <TextBlock Text="{Binding MainSlotHint}" Foreground="{StaticResource GoldHiBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="MainSlotHint" />
                    </Border>
                    <!-- a monitor of the layout went away -->
                    <Border Style="{StaticResource TipBox}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" MaxWidth="460"
                            Visibility="{Binding MonitorNotice, Converter={x:Static app:BoolVisibility.Instance}}">
                        <TextBlock Text="{Binding MonitorNotice}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="MonitorNotice" />
                    </Border>
                    <!-- Auto-fit notice -->
                    <Border Style="{StaticResource TipBox}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" MaxWidth="460"
                            Visibility="{Binding UiScaleNotice, Converter={x:Static app:BoolVisibility.Instance}}">
                        <TextBlock Text="{Binding UiScaleNotice}" Foreground="#1EFF00" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="UiScaleNotice" />
                    </Border>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- ===== Right: your squad ===== -->
        <ContentControl Grid.Column="4" Style="{StaticResource OrnatePanel}" Padding="14,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource HelpMark}" VerticalAlignment="Center" AutomationProperties.Name="Squad help">
                            <Border.ToolTip><TextBlock MaxWidth="320" TextWrapping="Wrap" Text="{Binding SquadHint}" /></Border.ToolTip>
                            <TextBlock Text="?" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GoldHiBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource H2}" FontSize="18" Text="Your squad" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- other installs' windows (mixed games) and extra windows: left alone, with a way to include them -->
                    <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap" Visibility="{Binding IgnoredText, Converter={x:Static app:BoolVisibility.Instance}}">
                        <Run Text="{Binding IgnoredText, Mode=OneWay}" Foreground="{StaticResource WarnBrush}" />
                        <Run Text=" · " Foreground="{StaticResource MutedBrush}" />
                        <Hyperlink Command="{Binding IncludeCommand}" Foreground="{StaticResource GoldHiBrush}" ToolTip="Let those windows join the squad too (until the app restarts)">Include</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="{Binding ExtraText}"
                               Visibility="{Binding ExtraText, Converter={x:Static app:BoolVisibility.Instance}}" />
                </StackPanel>

                <!-- Switching windows: Windows' own hover-to-activate, built in – the WoWBoxer way to switch. A Windows setting, never input. -->
                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" DataContext="{Binding Hover}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" AutomationProperties.AutomationId="HoverToggle" AutomationProperties.Name="Hover to activate windows"
                                  ToolTip="Windows' &quot;Activate a window by hovering over it with the mouse&quot;: the window under the mouse becomes active. Changes only this Windows setting – your own values are kept and can be put back in Settings.">
                            <TextBlock Text="Hover to activate windows" FontSize="13" />
                        </CheckBox>
                        <StackPanel Visibility="{Binding Enabled, Converter={x:Static app:BoolVisibility.Instance}}">
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Delay" Width="42" Margin="0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DelayText}" Width="112" Margin="8,0,0,0" FontSize="11.5" Foreground="{StaticResource ParchmentBrush}" VerticalAlignment="Center" />
                                <Slider Minimum="0" Maximum="500" Ticks="30" SmallChange="5" LargeChange="50" Value="{Binding DelayPreview}"
                                        app:SliderCommit.Command="{Binding CommitDelayCommand}" AutomationProperties.AutomationId="HoverDelay" AutomationProperties.Name="Hover delay in milliseconds"
                                        ToolTip="How long the mouse must rest on a window before it becomes active. 30 ms (the mark, the default) stops windows from activating as the mouse just passes over them. Applies when you let go." />
                            </DockPanel>
                            <DockPanel Margin="42,0,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Reset to default" FontSize="11.5" Command="{Binding ResetDelayCommand}"
                                        AutomationProperties.AutomationId="HoverResetDelay" ToolTip="Sets the delay back to 30 ms, at once. Your own Windows values from before: Settings › Restore." />
                                <TextBlock Text="{Binding DefaultDelayText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <CheckBox IsChecked="{Binding BringToFront}" Margin="0,6,0,0" AutomationProperties.AutomationId="HoverFront"
                                      ToolTip="Off: the active window stays where it is, so floating overlays stay visible. Works best with &quot;Always on top&quot; (the pin) on the followers.">
                                <TextBlock Text="Bring window to front when activated" FontSize="12" />
                            </CheckBox>
                        </StackPanel>
                        <!-- the facts, WoW tooltip style -->
                        <Border Style="{StaticResource TipBox}" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="16" Foreground="#E4E4E4">
                                <Run Text="Hover to activate is a Windows setting. It sends nothing to the game; WoWBoxer never sends keys or clicks." />
                                <LineBreak />
                                <Hyperlink Command="{Binding OpenGuideCommand}" Foreground="{StaticResource GoldHiBrush}" ToolTip="Guide › Switch between windows">Guide</Hyperlink>
                                <Run Text=" · " Foreground="{StaticResource MutedBrush}" />
                                <Hyperlink Command="{Binding OpenRulesCommand}" Foreground="{StaticResource GoldHiBrush}" ToolTip="The rules page: hover-to-activate (a Windows setting)">Rules on the website</Hyperlink>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Remove title bars: same layout Borderless flag as Settings › Window rules. Applies at once. Declared after Hover so it docks above it. -->
                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="0,10,0,0"
                        BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Borderless}"
                                  AutomationProperties.AutomationId="BorderlessToggle"
                                  AutomationProperties.Name="Remove title bars"
                                  ToolTip="Removes the Windows title bar and frame so slots sit edge to edge. WoW must stay Windowed. Off by default.">
                            <TextBlock Text="Remove title bars" FontSize="13" />
                        </CheckBox>
                        <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Off is safest. On removes the Windows frame; keep Display Mode on Windowed." />
                    </StackPanel>
                </Border>

                <!-- one compact row per window; drag ⋮⋮ to reorder; ▾ opens the window's details -->
                <ListBox x:Name="PartyList" ItemsSource="{Binding Party}" SelectedIndex="{Binding SelectedSlotIndex}" ItemContainerStyle="{StaticResource SquadItem}" PreviewGotKeyboardFocus="OnRowFocus"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Squad rows">
                    <!-- more than 5 clients: rows grouped as Party 1 and Party 2 (the grouping is set in code) -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource StepLabel}" Margin="2,2,0,6"
                                               Visibility="{Binding Name, Converter={x:Static app:BoolVisibility.Instance}}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- drag handle -->
                                <Border Background="Transparent" Cursor="SizeAll" Tag="{Binding}" ToolTip="Drag to move this character (and its window) to another slot"
                                        PreviewMouseLeftButtonDown="OnHandleDown" PreviewMouseMove="OnHandleMove" PreviewMouseLeftButtonUp="OnHandleUp">
                                    <TextBlock Text="⋮⋮" FontSize="15" Foreground="{StaticResource GoldLoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- number in the class colour -->
                                <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding Class.Name}">
                                    <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="2.2">
                                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#232B3E" Offset="0" /><GradientStop Color="#0B0E14" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource UiGoldBrush}" Effect="{StaticResource HardTextShadow}" />
                                </Grid>
                                <!-- name (optional) -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource DisplayFont}" Foreground="{Binding ClassBrush}" Padding="6,3"
                                             AutomationProperties.Name="Character name" ToolTip="The character playing in this slot (optional). Press Enter to save." />
                                    <!-- placeholder ("Main", "Follower 1"): hidden as soon as the box has text, not only once the name is saved -->
                                    <TextBlock Text="{Binding Title}" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="#80A79F8A"
                                               FontFamily="{StaticResource DisplayFont}"
                                               Visibility="{Binding Text, ElementName=NameBox, Converter={x:Static app:BoolVisibility.Instance}, ConverterParameter=not}" />
                                    <!-- window swap: this client sits in the main slot (or another slot) right now -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" CornerRadius="3" Padding="5,0,5,1" IsHitTestVisible="False"
                                            Background="{StaticResource GoldHiBrush}" Visibility="{Binding InMainSlot, Converter={x:Static app:BoolVisibility.Instance}}"
                                            AutomationProperties.AutomationId="InMainSlot">
                                        <TextBlock Text="IN MAIN SLOT" FontSize="9.5" FontFamily="{StaticResource DisplayFont}" Foreground="#141006" />
                                    </Border>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="10.5" Foreground="{StaticResource GoldBrush}" IsHitTestVisible="False"
                                               Text="{Binding SwapSlot}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InMainSlot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <!-- pin: always on top (gold = as wanted, red = being put right) -->
                                <Viewbox Grid.Column="3" Width="13" Height="13" Margin="6,0,0,0" ToolTip="{Binding PinText}" VerticalAlignment="Center"
                                         Visibility="{Binding ShowPin, Converter={x:Static app:BoolVisibility.Instance}}">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M7,9 L2,14" Stroke="{Binding PinBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Canvas.Left="6" Canvas.Top="2" Width="8" Height="8" Fill="{Binding PinBrush}" />
                                    </Canvas>
                                </Viewbox>
                                <!-- status chip -->
                                <Border Grid.Column="4" CornerRadius="9" BorderThickness="1" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding StateTip}"
                                        BorderBrush="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" Background="#40000000">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ChipDot" Width="6" Height="6" Margin="0,0,5,0" Fill="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding State, Converter={x:Static app:PartyStateBrush.Instance}}"
                                                   AutomationProperties.AutomationId="RowState" />
                                    </StackPanel>
                                </Border>
                                <!-- details -->
                                <Button Grid.Column="5" Margin="4,0,0,0" Width="24" Height="24" VerticalAlignment="Center" Cursor="Hand"
                                        Command="{Binding ToggleDetails}" AutomationProperties.Name="Details"
                                        ToolTip="Class, WoW account, always on top, Identify, size">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="Transparent" CornerRadius="4">
                                                <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#26E8C66A" /></Trigger>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- awaiting: the chip's dot pulses -->
                                <DataTrigger Binding="{Binding State}" Value="Awaiting">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Pulse">
                                            <Storyboard><DoubleAnimation Storyboard.TargetName="ChipDot" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse" /></DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ContentControl>

        <!-- ===== Footer: undo/reset, saved, and the one button ===== -->
        <Border Grid.Row="2" Grid.ColumnSpan="5" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,9">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1A2030" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush></Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="■  Stop" Command="{Binding StopCommand}" VerticalAlignment="Center" Margin="0,0,16,0" Padding="14,6" AutomationProperties.AutomationId="StopButton"
                            Visibility="{Binding Placing, Converter={x:Static app:BoolVisibility.Instance}}"
                            ToolTip="Stop placing windows: every window stays where it is until you press Start again (also in the tray menu)" />
                    <Button Style="{StaticResource LinkButton}" Content="Open Battle.net instead" Command="{Binding OpenBattleNetCommand}" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12.5"
                            ToolTip="Starts Battle.net (if needed); you press Play once per account. Each window snaps into its slot as it opens." />
                    <Button Style="{StaticResource EnterWorldButton}" Command="{Binding PrimaryCommand}" FontSize="16" Padding="22,8" MinWidth="250"
                            AutomationProperties.AutomationId="PrimaryButton" AutomationProperties.Name="{Binding PrimaryText}" ToolTip="{Binding PrimaryTip}">
                        <TextBlock Text="{Binding PrimaryText}" />
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" Margin="0,0,6,0" AutomationProperties.Name="Undo" ToolTip="Undo the last change (Ctrl+Z)" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding ResetCommand}" AutomationProperties.Name="Reset to preset"
                        ToolTip="Reset: put every window back where the chosen layout puts it (Ctrl+Z brings your changes back)" />
                <TextBlock Text="{Binding SavedText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,10,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
