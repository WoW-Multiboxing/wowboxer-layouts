<UserControl x:Class="WoWBoxer.Layouts.App.Views.CommunityBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:WoWBoxer.Layouts.App">
    <!-- Small, permanent community links in the brand style: Discord, YouTube, the website. Never a pop-up or a badge.
         The URLs come from Community.Links (the website's links.json, compiled-in fallback). DataContext = MainViewModel. -->
    <UserControl.Resources>
        <Style x:Key="IconLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="3">
                            <ContentPresenter x:Name="C" Opacity="0.75" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="C" Property="Opacity" Value="1" />
                                <Setter TargetName="B" Property="Background" Value="#26E8C66A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource IconLink}" Command="{Binding OpenDiscordCommand}" AutomationProperties.Name="Discord" AutomationProperties.AutomationId="LinkDiscord"
                ToolTip="Join the WoWBoxer Discord – tips, layouts and help">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{StaticResource GoldHiBrush}"
                              Data="M5,6 C8,4.4 16,4.4 19,6 C21,9.5 22,13 21.5,17 C19.5,18.6 17.6,19.4 16,19.8 L15,18 C16,17.6 17,17.1 17.8,16.5 C14,18.3 10,18.3 6.2,16.5 C7,17.1 8,17.6 9,18 L8,19.8 C6.4,19.4 4.5,18.6 2.5,17 C2,13 3,9.5 5,6 Z" />
                        <Ellipse Canvas.Left="7.2" Canvas.Top="10.4" Width="3.2" Height="3.6" Fill="#0B0E14" />
                        <Ellipse Canvas.Left="13.6" Canvas.Top="10.4" Width="3.2" Height="3.6" Fill="#0B0E14" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Discord" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ParchmentBrush}" FontSize="13"
                           Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:BoolVisibility.Instance}}" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource IconLink}" Command="{Binding OpenYouTubeCommand}" AutomationProperties.Name="YouTube" AutomationProperties.AutomationId="LinkYouTube"
                ToolTip="WoWBoxer on YouTube – guides and setups">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="2" Canvas.Top="5" Width="20" Height="14" RadiusX="4" RadiusY="4" Fill="{StaticResource GoldHiBrush}" />
                        <Path Fill="#0B0E14" Data="M10,8.6 L15.6,12 L10,15.4 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="YouTube" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ParchmentBrush}" FontSize="13"
                           Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:BoolVisibility.Instance}}" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource IconLink}" Command="{Binding OpenWebsiteCommand}" AutomationProperties.Name="Website" AutomationProperties.AutomationId="LinkWebsite"
                ToolTip="wowboxer.com – guides, rules and downloads">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource GoldHiBrush}" />
                </Viewbox>
                <TextBlock Text="Website" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ParchmentBrush}" FontSize="13"
                           Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:BoolVisibility.Instance}}" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
