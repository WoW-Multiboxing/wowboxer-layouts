<!--
  "War Table" theme – the look of the WoWBoxer website mockup (03_Output/WoWBoxer-mockup/styles.css):
  dark navy panels, gold trim, parchment headings, red/gold "Enter World" button, GameTooltip-style tooltips.
  Everything here is our own vector styling. No Blizzard logos, art, icons or UI textures.
  Heading font: Cinzel (SIL OFL 1.1, Assets/Fonts). Body: Segoe UI Variable (Windows).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WoWBoxer.Layouts.App">

    <!-- ===== Palette (mockup :root) ===== -->
    <Color x:Key="NightColor">#0B0E14</Color>
    <Color x:Key="Night2Color">#0F131C</Color>
    <Color x:Key="PanelColor">#151A24</Color>
    <Color x:Key="Panel2Color">#1C2333</Color>
    <Color x:Key="Panel3Color">#232B3E</Color>
    <Color x:Key="GoldColor">#C9A24A</Color>
    <Color x:Key="GoldHiColor">#E8C66A</Color>
    <Color x:Key="GoldLoColor">#8C6B26</Color>
    <Color x:Key="ParchmentColor">#E9DFC4</Color>
    <Color x:Key="TextColor">#D6CDB6</Color>
    <Color x:Key="MutedColor">#A79F8A</Color>
    <Color x:Key="UiGoldColor">#FFD100</Color>

    <SolidColorBrush x:Key="NightBrush" Color="{StaticResource NightColor}" />
    <SolidColorBrush x:Key="Night2Brush" Color="{StaticResource Night2Color}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}" />
    <SolidColorBrush x:Key="Panel3Brush" Color="{StaticResource Panel3Color}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldHiBrush" Color="{StaticResource GoldHiColor}" />
    <SolidColorBrush x:Key="GoldLoBrush" Color="{StaticResource GoldLoColor}" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource ParchmentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="UiGoldBrush" Color="{StaticResource UiGoldColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="#52C9A24A" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#29C9A24A" />
    <SolidColorBrush x:Key="OkBrush" Color="#8CCB7A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E6B455" />
    <SolidColorBrush x:Key="NoBrush" Color="#E37A7E" />
    <SolidColorBrush x:Key="FieldBrush" Color="#0D1018" />

    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7E3A6" Offset="0" />
        <GradientStop Color="#C9A24A" Offset="0.55" />
        <GradientStop Color="#8C6B26" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldGlint" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E8C66A" Offset="0" />
        <GradientStop Color="#B0E8C66A" Offset="0.5" />
        <GradientStop Color="#00E8C66A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1E2536" Offset="0" />
        <GradientStop Color="#151A24" Offset="0.55" />
        <GradientStop Color="#11151E" Offset="1" />
    </LinearGradientBrush>
    <!-- War-table background: warm lamp light top right, cool light left, faint map grid -->
    <DrawingBrush x:Key="WarTableBrush" Stretch="None" TileMode="None" AlignmentX="Left" AlignmentY="Top" Viewport="0,0,1,1">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0B0E14"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2400,1600" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Brush>
                    <RadialGradientBrush Center="0.78,0" GradientOrigin="0.78,0" RadiusX="0.55" RadiusY="0.7">
                        <GradientStop Color="#1FE8C66A" Offset="0" /><GradientStop Color="#00E8C66A" Offset="1" />
                    </RadialGradientBrush></GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2400,1600" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Brush>
                    <RadialGradientBrush Center="0,0.35" GradientOrigin="0,0.35" RadiusX="0.45" RadiusY="0.55">
                        <GradientStop Color="#1A2A5BA8" Offset="0" /><GradientStop Color="#002A5BA8" Offset="1" />
                    </RadialGradientBrush></GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2400,1600" /></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="MapGridBrush" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen><Pen Brush="#09C9A24A" Thickness="1" /></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0.5" EndPoint="64,0.5" /><LineGeometry StartPoint="0.5,0" EndPoint="0.5,64" /></GeometryGroup></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===== Type ===== -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Cinzel Bold</FontFamily>
    <FontFamily x:Key="DisplaySemiFont">pack://application:,,,/Assets/Fonts/#Cinzel SemiBold</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <DropShadowEffect x:Key="HardTextShadow" ShadowDepth="1" Direction="270" BlurRadius="2" Color="Black" Opacity="0.95" />
    <DropShadowEffect x:Key="PanelShadow" ShadowDepth="10" Direction="270" BlurRadius="28" Color="Black" Opacity="0.5" />

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="Effect" Value="{StaticResource HardTextShadow}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
        <Setter Property="Effect" Value="{StaticResource HardTextShadow}" />
    </Style>
    <Style x:Key="StepLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplaySemiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <!-- ===== Panels ===== -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A panel with four gold corner brackets (mockup .panel.ornate) -->
    <Style x:Key="OrnatePanel" TargetType="ContentControl">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Style="{StaticResource PanelBorder}" Padding="0" Effect="{StaticResource PanelShadow}" />
                        <Border BorderBrush="#99000000" BorderThickness="1" CornerRadius="9" Margin="1" />
                        <!-- corner brackets -->
                        <Grid Margin="7" IsHitTestVisible="False" Opacity="0.85">
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,16 L0,0 L16,0" Stroke="{StaticResource GoldBrush}" StrokeThickness="2" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L16,0 L16,16" Stroke="{StaticResource GoldBrush}" StrokeThickness="2" />
                            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L0,16 L16,16" Stroke="{StaticResource GoldBrush}" StrokeThickness="2" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M16,0 L16,16 L0,16" Stroke="{StaticResource GoldBrush}" StrokeThickness="2" />
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ornamental divider: line – diamond – line -->
    <Style x:Key="Divider" TargetType="ContentControl">
        <Setter Property="Height" Value="12" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Opacity="0.85">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Rectangle Height="1" VerticalAlignment="Center"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00C9A24A" Offset="0" /><GradientStop Color="#C9A24A" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                        <Rectangle Grid.Column="1" Width="8" Height="8" Stroke="{StaticResource GoldBrush}" Fill="{StaticResource NightBrush}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                            <Rectangle.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#E8C66A" Opacity="0.5" /></Rectangle.Effect>
                        </Rectangle>
                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C9A24A" Offset="0" /><GradientStop Color="#00C9A24A" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Focus ===== -->
    <Style x:Key="GoldFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{StaticResource GoldHiBrush}" BorderThickness="1.5" CornerRadius="5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- Default: the dark in-game panel button (mockup .btn-ghost) with a gold hover glow -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplaySemiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        
                        <Border x:Name="Glow" CornerRadius="5" Background="#01000000" Margin="1">
                            <Border.Effect><DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="16" Color="#E8C66A" Opacity="0" /></Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="4" BorderThickness="1.5" BorderBrush="#6B5422">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2A2F3C" Offset="0" /><GradientStop Color="#171A22" Offset="0.5" /><GradientStop Color="#0D0F15" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="3" Margin="1.5" BorderThickness="1" BorderBrush="#12FFFFFF" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          Effect="{StaticResource HardTextShadow}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter Property="Foreground" Value="#FFE45C" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The big red/gold call to action (mockup .btn-primary, the in-game "Enter World" feel) -->
    <Style x:Key="EnterWorldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Padding" Value="28,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        
                        <Border CornerRadius="6" Background="Black" Margin="-1" />
                        <Border x:Name="Halo" CornerRadius="6" BorderThickness="3" BorderBrush="#8C8C6B26" Margin="-3">
                            <Border.Effect><DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="26" Color="#FF5A28" Opacity="0.15" /></Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="5" BorderThickness="2" BorderBrush="{StaticResource GoldBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#B3201A" Offset="0" /><GradientStop Color="#8A140F" Offset="0.5" /><GradientStop Color="#4E0806" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- gloss on the upper half -->
                        <Border CornerRadius="4,4,0,0" Margin="2,2,2,0" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=Body, Converter={x:Static local:HalfConverter.Instance}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#33FFFFFF" Offset="0" /><GradientStop Color="#08FFFFFF" Offset="1" /></LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="4" Margin="2" BorderThickness="1" BorderBrush="#4DFFE196" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource HardTextShadow}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFE45C" />
                            <Setter TargetName="Halo" Property="BorderBrush" Value="#B3E8C66A" />
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1" /></Setter.Value></Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.3" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet text button (links, toolbar actions) -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Text" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F5DC93" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1FC9A24A" />
                            <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#B3201A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation tabs (mockup .nav: Cinzel caps, gold diamond under the current page) ===== -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="2,0">
                        <Border x:Name="Hover" CornerRadius="4" Background="#12C9A24A" Opacity="0" Margin="0,6" />
                        <ContentPresenter Margin="16,0" VerticalAlignment="Center" Effect="{StaticResource HardTextShadow}" />
                        <Rectangle x:Name="Diamond" Width="7" Height="7" Fill="{StaticResource GoldHiBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                   RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                            <Rectangle.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#E8C66A" Opacity="0.9" /></Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Diamond" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Diamond" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented choice (squad size, game) – mockup .seg ===== -->
    <Style x:Key="SegButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="0,0,6,0">
                        <Border x:Name="Body" CornerRadius="5" BorderThickness="1.5" BorderBrush="#3A4560" Background="#121722">
                            <Border.Effect><DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="14" Color="#E8C66A" Opacity="0" /></Border.Effect>
                        </Border>
                        <ContentPresenter Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource HardTextShadow}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldLoBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" />
                            <Setter TargetName="Body" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A2E14" Offset="0" /><GradientStop Color="#1C170C" Offset="1" /></LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SmallSegButton" TargetType="RadioButton" BasedOn="{StaticResource SegButton}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource DisplaySemiFont}" />
    </Style>

    <!-- ===== CheckBox (gold box) and Switch ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" BorderThickness="1.5" BorderBrush="#6B5422" Background="{StaticResource FieldBrush}" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3.5,9 L7.5,13 L14.5,4.5" Stroke="{StaticResource UiGoldBrush}" StrokeThickness="2.2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Opacity="0" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GoldBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <Grid DockPanel.Dock="Right" Width="42" Height="22" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" Background="#121722" BorderBrush="#3A4560" BorderThickness="1.5" />
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobX" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#3A2E14" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource UiGoldBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><QuadraticEase /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><QuadraticEase /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text input ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource GoldHiBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" CornerRadius="4" BorderThickness="1.5" BorderBrush="#3A4560" Background="{StaticResource FieldBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource GoldLoBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Field" CornerRadius="4" BorderThickness="1.5" BorderBrush="#3A4560" Background="{StaticResource FieldBrush}">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource GoldLoBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource GoldHiBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocus}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360" Margin="0,4,8,8"
                                    CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource GoldLoBrush}" Background="#F00C0F1A">
                                <Border.Effect><DropShadowEffect ShadowDepth="6" BlurRadius="16" Opacity="0.6" /></Border.Effect>
                                <ScrollViewer Margin="4"><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26C9A24A" />
                            <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lists ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#14C9A24A" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#24C9A24A" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbars: thin gold thumb ===== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="#55C9A24A" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#99C9A24A" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                        <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2,1">
                                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tooltips: the in-game GameTooltip look ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="#E4E4E4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="0,0,10,10" CornerRadius="5" BorderThickness="1" BorderBrush="#8E8E8E" Padding="10,7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F70C0F1E" Offset="0" /><GradientStop Color="#F7060812" Offset="1" /></LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect><DropShadowEffect ShadowDepth="5" BlurRadius="14" Opacity="0.6" /></Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Context menu (tray-like menus in the app) ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource GoldLoBrush}" Background="#F70C0F1A" Padding="4" Margin="0,0,8,8">
                        <Border.Effect><DropShadowEffect ShadowDepth="5" BlurRadius="14" Opacity="0.6" /></Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" CornerRadius="4" Padding="12,7" Background="Transparent">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26C9A24A" />
                            <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hyperlinks in text -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}" />
        <Setter Property="TextDecorations" Value="None" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#F5DC93" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
