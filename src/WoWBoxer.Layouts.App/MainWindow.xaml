<Window x:Class="WoWBoxer.Layouts.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WoWBoxer.Layouts.App.Controls"
        xmlns:app="clr-namespace:WoWBoxer.Layouts.App"
        Title="WoWBoxer Window Layouts" Width="1400" Height="860" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Window.Resources>
        <app:PresetNameConverter x:Key="PresetName" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- ================= Layouts ================= -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Image Source="Assets/app.png" Width="28" Height="28" Margin="0,0,10,0" />
                <TextBlock Text="Layouts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <WrapPanel>
                    <Button Style="{StaticResource Small}" Content="New" Command="{Binding NewProfileCommand}" ToolTip="New layout from the preset below the canvas" />
                    <Button Style="{StaticResource Small}" Content="Duplicate" Command="{Binding DuplicateCommand}" />
                    <Button Style="{StaticResource Small}" Content="Rename" Command="{Binding RenameCommand}" />
                    <Button Style="{StaticResource Small}" Content="Delete" Command="{Binding DeleteCommand}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Section}" Text="Share and capture" />
                <WrapPanel>
                    <Button Style="{StaticResource Small}" Content="Copy code" Command="{Binding CopyCodeCommand}" ToolTip="Copy this layout as a WBX1: code" />
                    <Button Style="{StaticResource Small}" Content="Paste code" Command="{Binding ImportCodeCommand}" />
                    <Button Style="{StaticResource Small}" Content="Open file…" Command="{Binding ImportFileCommand}" />
                    <Button Style="{StaticResource Small}" Content="Save file…" Command="{Binding ExportFileCommand}" />
                </WrapPanel>
                <Button Content="Capture current windows" Command="{Binding CaptureCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                        ToolTip="Arrange the WoW windows by hand (e.g. Windows Snap), then save that as a layout" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================= Canvas + editor ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" Padding="12,4" />
                <StackPanel>
                    <TextBlock Text="{Binding ProfileTitle}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MonitorSummary}" Style="{StaticResource Hint}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" CornerRadius="8" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                <c:LayoutCanvas x:Name="Canvas" Profile="{Binding Current}" Monitors="{Binding Monitors}"
                                SelectedIndex="{Binding SelectedSlotIndex}" />
            </Border>
            <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Margin="2,6,0,0"
                       Text="Drag a window to move it, drag the handles to resize. Edges snap to monitors and other windows (hold Alt to place freely). Arrow keys nudge (Shift = 10 px, Ctrl = resize), Tab selects the next window." />

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- preset + options -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Section}" Text="Preset" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding PresetKinds}" SelectedItem="{Binding PresetKind}" Width="190" Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PresetName}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding ClientCounts}" SelectedItem="{Binding PresetClients}" Width="70" Margin="0,0,8,0" ToolTip="Number of clients" />
                        <Button Content="Apply" Command="{Binding ApplyPresetCommand}" Padding="14,4" ToolTip="Replace this layout's windows with the preset (Ctrl+Z undoes it)" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Window rules" />
                    <ComboBox ItemsSource="{Binding AspectChoices}" SelectedItem="{Binding SelectedAspect}" Margin="0,0,0,8"
                              ToolTip="Windows narrower than this lose height (they are not stretched) so WoW draws them without black bars" />
                    <CheckBox Content="Remove title bars (borderless)" IsChecked="{Binding Borderless}"
                              ToolTip="Off is safest: WoW can draw its UI at the wrong size when the frame is removed" />
                    <CheckBox Content="Use the taskbar area too" IsChecked="{Binding UseTaskbarArea}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- selected slot -->
                <StackPanel Grid.Column="2" IsEnabled="{Binding HasSlot}">
                    <TextBlock Style="{StaticResource Section}" Text="{Binding SlotHeader}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding SlotName, UpdateSourceTrigger=LostFocus}" ToolTip="Character name; the WoW window title becomes &quot;WoW - name&quot;" />
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="X" Style="{StaticResource Hint}" /><TextBox Text="{Binding SlotX, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Y" Style="{StaticResource Hint}" /><TextBox Text="{Binding SlotY, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Width" Style="{StaticResource Hint}" /><TextBox Text="{Binding SlotW, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel><TextBlock Text="Height" Style="{StaticResource Hint}" /><TextBox Text="{Binding SlotH, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Always on top (overlay)" IsChecked="{Binding SlotOnTop}" Margin="0,0,16,0" />
                        <CheckBox Content="Keep exact size" IsChecked="{Binding SlotKeepSize}" ToolTip="Do not shrink this window to the aspect rule" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SlotInfo}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= Squad ================= -->
        <DockPanel Grid.Column="2" Margin="16,0,0,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Squad" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Classic Era" IsChecked="{Binding Forever, Converter={x:Static app:InvertBool.Instance}}" Margin="0,0,16,0" />
                    <RadioButton Content="Forever" IsChecked="{Binding Forever}" />
                </StackPanel>
                <Button Content="▶  Start squad" Command="{Binding StartSquadCommand}" Style="{DynamicResource AccentButtonStyle}"
                        FontSize="16" Padding="12,10" HorizontalAlignment="Stretch"
                        ToolTip="Starts Battle.net, then places each WoW window as it opens. You press Play yourself." />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Arrange now" Command="{Binding ArrangeCommand}" HorizontalAlignment="Stretch" ToolTip="Place the open WoW windows in the order below" />
                    <Button Grid.Column="2" Content="Stop watching" Command="{Binding StopCommand}" HorizontalAlignment="Stretch" />
                </Grid>

                <DockPanel Margin="0,16,0,6">
                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshWindowsCommand}" Padding="10,3" />
                    <Button DockPanel.Dock="Right" Content="Identify" Command="{Binding IdentifyCommand}" Padding="10,3" Margin="0,0,6,0"
                            ToolTip="Show each window's slot number on top of it for a few seconds" />
                    <TextBlock Text="Open WoW windows" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Windows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Background="#12FFFFFF" Padding="8,6" Margin="0,0,0,4">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="▲" Padding="6,0" Margin="0,0,4,0" ToolTip="Earlier slot"
                                                Command="{Binding DataContext.MoveWindowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="▼" Padding="6,0" ToolTip="Later slot"
                                                Command="{Binding DataContext.MoveWindowDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Slot}" FontSize="18" FontWeight="SemiBold" Width="26" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Process}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Title WoW windows with the slot names" IsChecked="{Binding RenameWindows}" Margin="0,6,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource Small}" Content="Give title bars back" Command="{Binding RestoreFramesCommand}" />
                    <Button Style="{StaticResource Small}" Content="Diagnose" Command="{Binding DiagnoseCommand}"
                            ToolTip="Write a report (monitors, windows, admin rights, WoW display settings) and try one placement per window" />
                    <Button Style="{StaticResource Small}" Content="Logs" Command="{Binding OpenLogsCommand}" />
                    <Button Style="{StaticResource Small}" Content="Desktop shortcut" Click="OnCreateShortcut"
                            ToolTip="A shortcut that opens this app in the tray and starts the selected layout" />
                </WrapPanel>
                <TextBlock Text="Activity" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,6" />
            </StackPanel>
            <ListBox x:Name="StatusList" ItemsSource="{Binding Status.Lines}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Foreground="{Binding Brush}">
                            <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="Gray" /> <Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
