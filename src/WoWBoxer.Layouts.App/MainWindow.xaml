<Window x:Class="WoWBoxer.Layouts.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WoWBoxer Window Layouts" Height="300" Width="520"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="WoWBoxer Window Layouts" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Early development. The layout editor arrives in milestone M2. Until then, use the command line: wbx arrange | diagnose | start | info." />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="This app only moves and resizes windows. It never sends keys or mouse clicks to the game." />
    </StackPanel>
</Window>
