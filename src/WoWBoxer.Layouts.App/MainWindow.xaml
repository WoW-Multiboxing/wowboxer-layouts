<Window x:Class="WoWBoxer.Layouts.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:WoWBoxer.Layouts.App"
        xmlns:v="clr-namespace:WoWBoxer.Layouts.App.Views"
        Title="{Binding WindowTitle, Mode=OneWay}" Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{StaticResource NightBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetTabCommand}" CommandParameter="Setup" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetTabCommand}" CommandParameter="Guide" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetTabCommand}" CommandParameter="Settings" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SetTabCommand}" CommandParameter="About" />
        <KeyBinding Key="F5" Command="{Binding ArrangeCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding IdentifyCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding StartSquadCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding MoreClientsCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding FewerClientsCommand}" />
    </Window.InputBindings>

    <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <!-- war-table background -->
            <Rectangle Fill="{StaticResource WarTableBrush}" />
            <Rectangle Fill="{StaticResource MapGridBrush}" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- ===== Title bar: brand, tabs, caption buttons ===== -->
                <Border Grid.Row="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F70B0E14" Offset="0" /><GradientStop Color="#E00B0E14" Offset="1" /></LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource GoldGlint}" Opacity="0.6" />
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,26,0" VerticalAlignment="Center">
                                <Viewbox Width="30" Height="34" Margin="0,0,10,0">
                                    <Canvas Width="34" Height="38">
                                        <Path Data="M17 1.5l14.5 5v12.2c0 9.3-6.3 15.8-14.5 18.3C8.8 34.5 2.5 28 2.5 18.7V6.5z" Stroke="{StaticResource GoldGradient}" StrokeThickness="2">
                                            <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#232B3E" Offset="0" /><GradientStop Color="#0B0E14" Offset="1" /></LinearGradientBrush></Path.Fill>
                                        </Path>
                                        <Rectangle Canvas.Left="8" Canvas.Top="10.5" Width="10" Height="15" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource GoldGradient}" />
                                        <Rectangle Canvas.Left="19.5" Canvas.Top="10.5" Width="6.5" Height="7" RadiusX="1" RadiusY="1" Fill="#BFE8C66A" />
                                        <Rectangle Canvas.Left="19.5" Canvas.Top="18.5" Width="6.5" Height="7" RadiusX="1" RadiusY="1" Fill="#BFE8C66A" />
                                        <Path Data="M11 30.5h12" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="21" Foreground="{StaticResource ParchmentBrush}" Effect="{StaticResource HardTextShadow}">
                                    <Run Text="WoW" /><Run Text="Boxer" Foreground="{StaticResource GoldHiBrush}" />
                                </TextBlock>
                                <TextBlock Text="WINDOW LAYOUTS" VerticalAlignment="Center" Margin="10,3,0,0" FontFamily="{StaticResource DisplaySemiFont}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding Version, StringFormat=v{0}, Mode=OneWay}" VerticalAlignment="Center" Margin="8,3,0,0" FontSize="11" Foreground="{StaticResource GoldBrush}" Opacity="0.85"
                                           AutomationProperties.AutomationId="TitleVersion" ToolTip="Installed version – see About for what changed" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimise to the tray">
                                    <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                </Button>
                                <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximise / restore">
                                    <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                </Button>
                                <Button Style="{StaticResource CloseCaptionButton}" Click="OnClose" ToolTip="Quit">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                </Button>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="Live status">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource OkBrush}">
                                    <Ellipse.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#8CCB7A" Opacity="0.8" /></Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding HeaderStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Left">
                                <RadioButton Style="{StaticResource NavTab}" Content="SETUP" GroupName="nav"
                                             IsChecked="{Binding SelectedTab, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=Setup}"
                                             ToolTip="Clients, layout, your squad and Start squad – all on one screen (Ctrl+1)" />
                                <RadioButton Style="{StaticResource NavTab}" Content="GUIDE" GroupName="nav"
                                             IsChecked="{Binding SelectedTab, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=Guide}"
                                             ToolTip="Quick guide: WoW settings and tips (Ctrl+2)" />
                                <RadioButton Style="{StaticResource NavTab}" Content="SETTINGS" GroupName="nav"
                                             IsChecked="{Binding SelectedTab, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=Settings}"
                                             ToolTip="Game, windows, Battle.net, updates (Ctrl+3)" />
                                <RadioButton Style="{StaticResource NavTab}" Content="ABOUT" GroupName="nav"
                                             IsChecked="{Binding SelectedTab, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=About}"
                                             ToolTip="Version, licence, privacy (Ctrl+4)" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ===== Pages ===== -->
                <Grid Grid.Row="1" x:Name="Pages" Margin="20,16,20,10">
                    <v:SetupView x:Name="SetupPage" Visibility="{Binding SelectedTab, Converter={x:Static app:TabVisibility.Instance}, ConverterParameter=Setup}" />
                    <v:GuideView Visibility="{Binding SelectedTab, Converter={x:Static app:TabVisibility.Instance}, ConverterParameter=Guide}" />
                    <v:SettingsView Visibility="{Binding SelectedTab, Converter={x:Static app:TabVisibility.Instance}, ConverterParameter=Settings}" />
                    <v:AboutView Visibility="{Binding SelectedTab, Converter={x:Static app:TabVisibility.Instance}, ConverterParameter=About}" />
                </Grid>

                <!-- ===== Status bar ===== -->
                <Border Grid.Row="2" Background="#CC07090E" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0">
                    <DockPanel Margin="16,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MonitorSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding LastStatus.Brush, FallbackValue=Gray}" />
                        <TextBlock Text="{Binding LastStatus.Message, FallbackValue=Ready}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
